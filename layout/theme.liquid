<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ page_title }} — {{ shop.name }}</title>
  <meta name="description" content="{{ page_description | escape }}">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,600&display=swap" rel="stylesheet">

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['DM Sans', 'system-ui', 'sans-serif'],
            display: ['Cormorant Garamond', 'Georgia', 'serif']
          }
        }
      }
    }
  </script>

  {{ content_for_header }}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {% if template == 'product' %}
  <style>
    /* Oculta el botón de Releaseit — usamos nuestro botón sticky personalizado */
    .ri-buy-now-section, .ri-buy-button-wrapper, .ri-buy-now-wrapper,
    [class*="ri-buy-now"], [class*="ri-buy-button"], [id*="ri-buy"],
    .releaseit-buy-btn, .ri-sticky-btn, .ri-floating-btn { display: none !important; }
  </style>
  {% endif %}
</head>
<body class="bg-white text-[#1a1a18] overflow-x-hidden antialiased">

  {% section 'announcement-bar' %}
  {% section 'header' %}

  <main id="main-content">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}

  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
  {{ 'theme.js' | asset_url | script_tag }}
</body>
</html>
