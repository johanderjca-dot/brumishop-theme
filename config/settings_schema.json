[
  {
    "name": "theme_info",
    "theme_name": "BrumiShop",
    "theme_version": "1.0.0",
    "theme_author": "BrumiShop",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://help.shopify.com/manual/online-store/themes"
  },

  {
    "name": "Marca",
    "settings": [
      { "type": "image_picker", "id": "logo", "label": "Logo (para redes sociales)" },
      { "type": "image_picker", "id": "favicon", "label": "Favicon", "info": "32 x 32 px" },
      { "type": "image_picker", "id": "share_image", "label": "Imagen al compartir el enlace", "info": "1200 x 630 px" }
    ]
  },

  {
    "name": "Encabezado",
    "settings": [
      {
        "type": "checkbox",
        "id": "transparent_header",
        "label": "Encabezado transparente sobre el video (solo en la portada)",
        "default": true,
        "info": "El video se ve por detrás de la barra de navegación. Al bajar, la barra se vuelve sólida."
      }
    ]
  },

  {
    "name": "Colores",
    "settings": [
      { "type": "color", "id": "color_bg", "label": "Fondo", "default": "#FBFAF6" },
      { "type": "color", "id": "color_bg_alt", "label": "Fondo alterno", "default": "#EFEDE6" },
      { "type": "color", "id": "color_ink", "label": "Texto", "default": "#151515" },
      { "type": "color", "id": "color_muted", "label": "Texto secundario", "default": "#7A7A7A" },
      { "type": "color", "id": "color_line", "label": "Líneas y bordes", "default": "#DCDAD2" },
      { "type": "header", "content": "Botón principal" },
      { "type": "color", "id": "color_accent", "label": "Fondo del botón", "default": "#151515" },
      { "type": "color", "id": "color_accent_ink", "label": "Texto del botón", "default": "#FFFFFF" }
    ]
  },

  {
    "name": "Tipografía",
    "settings": [
      { "type": "font_picker", "id": "type_body_font", "label": "Fuente del cuerpo", "default": "assistant_n4" },
      { "type": "font_picker", "id": "type_heading_font", "label": "Fuente de los títulos", "default": "assistant_n7" },
      { "type": "range", "id": "type_heading_scale", "min": 80, "max": 140, "step": 5, "unit": "%", "label": "Tamaño de los títulos", "default": 100 },
      { "type": "range", "id": "type_heading_tracking", "min": -1, "max": 4, "step": 0.5, "unit": "px", "label": "Espaciado entre letras (títulos)", "default": 0.5 },
      {
        "type": "select",
        "id": "type_heading_uppercase",
        "label": "Títulos en mayúsculas",
        "default": "uppercase",
        "options": [
          { "value": "none", "label": "No" },
          { "value": "uppercase", "label": "Sí" }
        ]
      }
    ]
  },

  {
    "name": "Diseño",
    "settings": [
      { "type": "range", "id": "page_width", "min": 1000, "max": 1800, "step": 20, "unit": "px", "label": "Ancho máximo de la página", "default": 1400 },
      { "type": "range", "id": "section_padding", "min": 24, "max": 120, "step": 4, "unit": "px", "label": "Espacio entre secciones", "default": 56 },
      { "type": "range", "id": "button_radius", "min": 0, "max": 40, "step": 1, "unit": "px", "label": "Redondeo de los botones", "default": 10 },
      { "type": "range", "id": "card_radius", "min": 0, "max": 40, "step": 1, "unit": "px", "label": "Redondeo de las imágenes", "default": 12 }
    ]
  },

  {
    "name": "Redes sociales",
    "settings": [
      { "type": "text", "id": "social_instagram", "label": "Instagram" },
      { "type": "text", "id": "social_facebook", "label": "Facebook" },
      { "type": "text", "id": "social_tiktok", "label": "TikTok" },
      { "type": "text", "id": "social_whatsapp", "label": "WhatsApp", "info": "Enlace completo, por ejemplo https://wa.me/18095550000" }
    ]
  }
]
