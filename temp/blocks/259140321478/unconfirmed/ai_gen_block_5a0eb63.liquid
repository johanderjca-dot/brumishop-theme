{% doc %}
  @prompt
    
    
    tipo algo asi quiero agregar una sección de urgencia 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-urgency-banner-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    background: {{ block.settings.background_color }};
    padding: 20px;
    border-radius: {{ block.settings.border_radius }}px;
    text-align: center;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .ai-urgency-banner__icon-{{ ai_gen_id }} {
    font-size: {{ block.settings.icon_size }}px;
    margin-bottom: 12px;
  }

  .ai-urgency-banner__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    color: {{ block.settings.text_color }};
    margin: 0 0 8px 0;
  }

  .ai-urgency-banner__subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 16px 0;
    opacity: 0.9;
  }

  .ai-urgency-banner__timer-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin: 20px 0;
    flex-wrap: wrap;
  }

  .ai-urgency-banner__time-block-{{ ai_gen_id }} {
    background: {{ block.settings.timer_bg_color }};
    padding: 12px 16px;
    border-radius: {{ block.settings.timer_border_radius }}px;
    min-width: 70px;
  }

  .ai-urgency-banner__time-number-{{ ai_gen_id }} {
    font-size: {{ block.settings.timer_number_size }}px;
    font-weight: 700;
    color: {{ block.settings.timer_text_color }};
    display: block;
    line-height: 1;
  }

  .ai-urgency-banner__time-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.timer_label_size }}px;
    color: {{ block.settings.timer_text_color }};
    margin-top: 4px;
    display: block;
    opacity: 0.8;
  }

  .ai-urgency-banner__stock-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: {{ block.settings.stock_bg_color }};
    color: {{ block.settings.stock_text_color }};
    padding: 8px 16px;
    border-radius: 20px;
    font-size: {{ block.settings.stock_size }}px;
    font-weight: 600;
    margin-top: 12px;
  }

  .ai-urgency-banner__stock-icon-{{ ai_gen_id }} {
    width: 16px;
    height: 16px;
    animation: ai-urgency-pulse-{{ ai_gen_id }} 2s infinite;
  }

  @keyframes ai-urgency-pulse-{{ ai_gen_id }} {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-urgency-banner__timer-{{ ai_gen_id }} {
      gap: 8px;
    }

    .ai-urgency-banner__time-block-{{ ai_gen_id }} {
      min-width: 60px;
      padding: 10px 12px;
    }
  }
{% endstyle %}

<urgency-banner-{{ ai_gen_id }}
  class="ai-urgency-banner-{{ ai_gen_id }}"
  data-end-date="{{ block.settings.end_date }}"
  data-end-time="{{ block.settings.end_time }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.show_icon %}
    <div class="ai-urgency-banner__icon-{{ ai_gen_id }}">
      {{ block.settings.icon }}
    </div>
  {% endif %}

  {% if block.settings.title != blank %}
    <h2 class="ai-urgency-banner__title-{{ ai_gen_id }}">
      {{ block.settings.title }}
    </h2>
  {% endif %}

  {% if block.settings.subtitle != blank %}
    <p class="ai-urgency-banner__subtitle-{{ ai_gen_id }}">
      {{ block.settings.subtitle }}
    </p>
  {% endif %}

  {% if block.settings.show_timer %}
    <div class="ai-urgency-banner__timer-{{ ai_gen_id }}">
      <div class="ai-urgency-banner__time-block-{{ ai_gen_id }}">
        <span class="ai-urgency-banner__time-number-{{ ai_gen_id }}" data-days>00</span>
        <span class="ai-urgency-banner__time-label-{{ ai_gen_id }}">Días</span>
      </div>
      <div class="ai-urgency-banner__time-block-{{ ai_gen_id }}">
        <span class="ai-urgency-banner__time-number-{{ ai_gen_id }}" data-hours>00</span>
        <span class="ai-urgency-banner__time-label-{{ ai_gen_id }}">Horas</span>
      </div>
      <div class="ai-urgency-banner__time-block-{{ ai_gen_id }}">
        <span class="ai-urgency-banner__time-number-{{ ai_gen_id }}" data-minutes>00</span>
        <span class="ai-urgency-banner__time-label-{{ ai_gen_id }}">Min</span>
      </div>
      <div class="ai-urgency-banner__time-block-{{ ai_gen_id }}">
        <span class="ai-urgency-banner__time-number-{{ ai_gen_id }}" data-seconds>00</span>
        <span class="ai-urgency-banner__time-label-{{ ai_gen_id }}">Seg</span>
      </div>
    </div>
  {% endif %}

  {% if block.settings.show_stock %}
    <div class="ai-urgency-banner__stock-{{ ai_gen_id }}">
      <svg class="ai-urgency-banner__stock-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
      </svg>
      <span>{{ block.settings.stock_text }}</span>
    </div>
  {% endif %}
</urgency-banner-{{ ai_gen_id }}>

<script>
  (function() {
    class UrgencyBanner{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.endDate = this.dataset.endDate;
        this.endTime = this.dataset.endTime;
      }

      connectedCallback() {
        if (this.endDate && this.endTime) {
          this.startCountdown();
        }
      }

      startCountdown() {
        const endDateTime = new Date(this.endDate + 'T' + this.endTime).getTime();
        
        const updateTimer = () => {
          const now = new Date().getTime();
          const distance = endDateTime - now;

          if (distance < 0) {
            this.querySelector('[data-days]').textContent = '00';
            this.querySelector('[data-hours]').textContent = '00';
            this.querySelector('[data-minutes]').textContent = '00';
            this.querySelector('[data-seconds]').textContent = '00';
            return;
          }

          const days = Math.floor(distance / (1000 * 60 * 60 * 24));
          const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
          const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
          const seconds = Math.floor((distance % (1000 * 60)) / 1000);

          this.querySelector('[data-days]').textContent = String(days).padStart(2, '0');
          this.querySelector('[data-hours]').textContent = String(hours).padStart(2, '0');
          this.querySelector('[data-minutes]').textContent = String(minutes).padStart(2, '0');
          this.querySelector('[data-seconds]').textContent = String(seconds).padStart(2, '0');
        };

        updateTimer();
        this.interval = setInterval(updateTimer, 1000);
      }

      disconnectedCallback() {
        if (this.interval) {
          clearInterval(this.interval);
        }
      }
    }

    customElements.define('urgency-banner-{{ ai_gen_id }}', UrgencyBanner{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Banner de urgencia",
  "settings": [
    {
      "type": "header",
      "content": "Contenido"
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Mostrar ícono",
      "default": true
    },
    {
      "type": "text",
      "id": "icon",
      "label": "Ícono",
      "default": "🔥"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "¡Oferta por tiempo limitado!"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "Aprovecha este descuento antes de que termine"
    },
    {
      "type": "header",
      "content": "Temporizador"
    },
    {
      "type": "checkbox",
      "id": "show_timer",
      "label": "Mostrar temporizador",
      "default": true
    },
    {
      "type": "text",
      "id": "end_date",
      "label": "Fecha de finalización",
      "default": "2026-07-15",
      "info": "Formato: AAAA-MM-DD"
    },
    {
      "type": "text",
      "id": "end_time",
      "label": "Hora de finalización",
      "default": "23:59",
      "info": "Formato: HH:MM (24 horas)"
    },
    {
      "type": "header",
      "content": "Inventario limitado"
    },
    {
      "type": "checkbox",
      "id": "show_stock",
      "label": "Mostrar mensaje de stock",
      "default": true
    },
    {
      "type": "text",
      "id": "stock_text",
      "label": "Texto de stock",
      "default": "¡Solo quedan 5 unidades!"
    },
    {
      "type": "header",
      "content": "Diseño"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Ancho en escritorio",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Radio de borde",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Fondo",
      "default": "#F2EBC4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texto",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "timer_bg_color",
      "label": "Fondo del temporizador",
      "default": "#5a7a40"
    },
    {
      "type": "color",
      "id": "timer_text_color",
      "label": "Texto del temporizador",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "stock_bg_color",
      "label": "Fondo de stock",
      "default": "#ff4444"
    },
    {
      "type": "color",
      "id": "stock_text_color",
      "label": "Texto de stock",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Tamaños de texto"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Tamaño del ícono",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Tamaño del título",
      "min": 16,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "label": "Tamaño del subtítulo",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "timer_number_size",
      "label": "Tamaño números temporizador",
      "min": 20,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "timer_label_size",
      "label": "Tamaño etiquetas temporizador",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "stock_size",
      "label": "Tamaño texto de stock",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "timer_border_radius",
      "label": "Radio de borde temporizador",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 6
    }
  ],
  "presets": [
    {
      "name": "Banner de urgencia"
    }
  ]
}
{% endschema %}