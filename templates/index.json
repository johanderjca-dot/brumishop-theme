    "trust-bar": {
      "type": "trust-bar",
      "blocks": {
        "item-1": { "type": "item", "settings": { "icon": "○", "text": "Envío gratis desde $50" } },
        "item-2": { "type": "item", "settings": { "icon": "◇", "text": "Devoluciones en 30 días" } },
