<section class="page-width section-pad" style="max-width:520px">
  <h1 class="h1">Nueva contraseña</h1>
  {%- form 'reset_customer_password' -%}
    {{ form.errors | default_errors }}
    <p><label for="ResetPass">Contraseña</label><input type="password" name="customer[password]" id="ResetPass" autocomplete="new-password"></p>
    <p><label for="ResetPass2">Confirmar</label><input type="password" name="customer[password_confirmation]" id="ResetPass2" autocomplete="new-password"></p>
    <p><button type="submit" class="btn btn--primary btn--full">Guardar</button></p>
  {%- endform -%}
</section>
