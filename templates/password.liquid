<section class="page-width section-pad center" style="max-width:520px">
  <h1 class="h1">{{ shop.name }}</h1>
  <p>Estamos preparando algo bueno. Vuelve pronto.</p>
  {%- form 'storefront_password' -%}
    {{ form.errors | default_errors }}
    <p><label for="Pass">Contraseña de la tienda</label><input type="password" name="password" id="Pass"></p>
    <p><button type="submit" class="btn btn--primary btn--full">Entrar</button></p>
  {%- endform -%}
</section>
