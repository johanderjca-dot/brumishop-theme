<div class="max-w-[1320px] mx-auto px-6 py-12">
  <div class="mb-8 border-b border-[#E8E8E2] pb-6">
    <h1 class="font-display text-3xl font-semibold text-[#1a1a18]">{{ collection.title }}</h1>
    {% if collection.description != blank %}
      <p class="mt-2 text-sm text-[#6a6a62] max-w-xl">{{ collection.description }}</p>
    {% endif %}
    <p class="mt-2 text-xs text-[#a0a09a]">{{ collection.products_count }} productos</p>
  </div>

  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-5">
    {% for product in collection.products %}
      {% render 'product-card', product: product %}
    {% endfor %}
  </div>

  {% if paginate.pages > 1 %}
    {% paginate collection.products by 20 %}
      <div class="mt-12 flex justify-center gap-2">
        {% if paginate.previous %}
          <a href="{{ paginate.previous.url }}" class="px-4 py-2 border border-[#E0E0DA] text-sm text-[#1a1a18] hover:bg-[#F8F7F3]">← Anterior</a>
        {% endif %}
        {% if paginate.next %}
          <a href="{{ paginate.next.url }}" class="px-4 py-2 border border-[#E0E0DA] text-sm text-[#1a1a18] hover:bg-[#F8F7F3]">Siguiente →</a>
        {% endif %}
      </div>
    {% endpaginate %}
  {% endif %}
</div>
