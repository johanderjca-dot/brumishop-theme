{% assign images = product.images %}
{% assign img_count = images.size %}
{% assign desktop_count = section.blocks.size %}

<style>
  .lp-hero-track {
    display: flex;
    transition: transform 0.45s cubic-bezier(0.23,1,0.32,1);
    will-change: transform;
  }
  .lp-hero-slide {
    flex: 0 0 100%;
    line-height: 0;
  }
  .lp-hero-slide img {
    width: 100%;
    object-fit: cover;
    display: block;
    background: {{ section.settings.bg_color }};
  }
  .lp-desktop-slider { display: none; }
  .lp-mobile-slider  { display: block; }
  @media (min-width: 640px) {
    .lp-desktop-slider { display: block; }
    .lp-mobile-slider  { display: none; }
    .lp-hero-slide img { max-height: {{ section.settings.max_height }}px; }
  }
  @media (max-width: 639px) {
    .lp-hero-slide img { max-height: {{ section.settings.max_height_mobile }}px; }
  }
</style>

<section style="background:{{ section.settings.bg_color }}; padding-top:{{ section.settings.pt }}px;">

  {% if desktop_count > 0 %}
    <!-- Slider desktop panorámico (bloques) -->
    <div class="lp-desktop-slider" style="overflow:hidden;">
      <div class="lp-hero-track" id="lp-desktop-track-{{ section.id }}">
        {% for block in section.blocks %}
          {% if block.settings.image != blank %}
            <div class="lp-hero-slide" {{ block.shopify_attributes }}>
              <img src="{{ block.settings.image | image_url: width: 2000 }}"
                   srcset="{{ block.settings.image | image_url: width: 800 }} 800w,
                           {{ block.settings.image | image_url: width: 1200 }} 1200w,
                           {{ block.settings.image | image_url: width: 2000 }} 2000w"
                   sizes="100vw"
                   alt="{{ block.settings.alt | default: product.title | escape }}"
                   loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  {% endif %}

  {% if img_count > 0 %}
    <!-- Slider mobile (fotos del producto) -->
    <div class="{% if desktop_count > 0 %}lp-mobile-slider{% endif %}" style="overflow:hidden;">
      <div class="lp-hero-track" id="lp-hero-track-{{ section.id }}">
        {% for image in images %}
          <div class="lp-hero-slide">
            <img src="{{ image | image_url: width: 1200 }}"
                 srcset="{{ image | image_url: width: 600 }} 600w,
                         {{ image | image_url: width: 900 }} 900w,
                         {{ image | image_url: width: 1200 }} 1200w"
                 sizes="100vw"
                 alt="{{ product.title | escape }}"
                 loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
          </div>
        {% endfor %}
      </div>
    </div>
  {% else %}
    <div class="{% if desktop_count > 0 %}lp-mobile-slider{% endif %}"
         style="background:#E8E8E2; height:{{ section.settings.max_height_mobile }}px; display:flex; align-items:center; justify-content:center;">
      <p style="color:#a0a09a; font-size:0.875rem;">Sube imágenes al producto en Shopify Admin.</p>
    </div>
  {% endif %}

</section>

{% if desktop_count > 1 %}
<script>
(function(){
  var track = document.getElementById('lp-desktop-track-{{ section.id }}');
  if (!track) return;
  var total = {{ desktop_count }};
  var current = 0;
  function goTo(i) {
    current = (i + total) % total;
    track.style.transform = 'translateX(-' + (current * 100) + '%)';
  }
  setInterval(function(){ goTo(current + 1); }, {{ section.settings.speed }}000);
})();
</script>
{% endif %}

{% if img_count > 1 %}
<script>
(function(){
  var track = document.getElementById('lp-hero-track-{{ section.id }}');
  if (!track) return;
  var total = {{ img_count }};
  var current = 0;
  function goTo(i) {
    current = (i + total) % total;
    track.style.transform = 'translateX(-' + (current * 100) + '%)';
  }
  setInterval(function(){ goTo(current + 1); }, {{ section.settings.speed }}000);
})();
</script>
{% endif %}

{% schema %}
{
  "name": "1 — Foto Hero",
  "settings": [
    { "type": "range", "id": "max_height", "label": "Altura banner desktop (px)", "min": 200, "max": 800, "step": 10, "default": 420 },
    { "type": "range", "id": "max_height_mobile", "label": "Altura máxima móvil (px)", "min": 200, "max": 600, "step": 10, "default": 340 },
    { "type": "range", "id": "pt", "label": "Espacio superior (px)", "min": 0, "max": 48, "step": 4, "default": 0 },
    { "type": "range", "id": "speed", "label": "Velocidad auto-slide (seg)", "min": 2, "max": 10, "step": 1, "default": 3 },
    { "type": "color", "id": "bg_color", "label": "Color de fondo", "default": "#FFFFFF" }
  ],
  "max_blocks": 10,
  "blocks": [
    {
      "type": "slide",
      "name": "Banner desktop",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen panorámica" },
        { "type": "text", "id": "alt", "label": "Texto alternativo (opcional)" }
      ]
    }
  ],
  "presets": [{ "name": "1 — Foto Hero" }]
}
{% endschema %}
