{% if section.blocks.size > 0 %}
<style>
  .ct-wrap {
    background: {{ section.settings.bg_color }};
    padding: {{ section.settings.pt }}px {{ section.settings.px }}px {{ section.settings.pb }}px;
  }
  .ct-label {
    font-size: {{ section.settings.label_size }}px;
    font-weight: 700;
    color: {{ section.settings.label_color }};
    margin: 0 0 {{ section.settings.label_gap }}px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .ct-slider-wrap { overflow: hidden; }
  .ct-track {
    display: flex;
    gap: {{ section.settings.gap }}px;
    transition: transform 0.45s cubic-bezier(0.23,1,0.32,1);
    will-change: transform;
  }
  .ct-slide {
    flex: 0 0 calc((100% - {{ section.settings.gap | times: section.settings.per_view | minus: section.settings.gap }}px) / {{ section.settings.per_view }});
    border-radius: {{ section.settings.radius }}px;
    overflow: hidden;
    line-height: 0;
  }
  .ct-slide img {
    width: 100%;
    height: {{ section.settings.photo_height }}px;
    object-fit: cover;
    display: block;
  }
  .ct-dots {
    display: flex;
    justify-content: center;
    gap: 6px;
    margin-top: 12px;
  }
  .ct-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: #c8c8c0;
    border: none; padding: 0; cursor: pointer;
    transition: background .2s, transform .2s;
  }
  .ct-dot.active { background: {{ section.settings.label_color }}; transform: scale(1.3); }
</style>

<section class="ct-wrap">
  {% if section.settings.label != blank %}
    <p class="ct-label">{{ section.settings.label }}</p>
  {% endif %}

  <div class="ct-slider-wrap">
    <div class="ct-track" id="ct-track-{{ section.id }}">
      {% for block in section.blocks %}
        {% if block.settings.photo != blank %}
          <div class="ct-slide" {{ block.shopify_attributes }}>
            <img src="{{ block.settings.photo | image_url: width: 600 }}"
                 alt="{{ block.settings.alt | default: 'Cliente usando el producto' | escape }}"
                 loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>

</section>

<script>
(function(){
  var track = document.getElementById('ct-track-{{ section.id }}');
  if (!track) return;
  var total   = {{ section.blocks.size }};
  var perView = {{ section.settings.per_view }};
  var current = 0;

  function goTo(i) {
    var max = Math.max(0, total - perView);
    current = Math.min(Math.max((i + total) % total, 0), max);
    var slideW = track.children[0] ? track.children[0].offsetWidth + {{ section.settings.gap }} : 0;
    track.style.transform = 'translateX(-' + (current * slideW) + 'px)';
  }

  setInterval(function(){ goTo(current + 1); }, {{ section.settings.speed }}000);
})();
</script>
{% endif %}

{% schema %}
{
  "name": "Fotos Clientes",
  "settings": [
    { "type": "text", "id": "label", "label": "Título", "default": "Imágenes clientes:" },
    { "type": "range", "id": "label_size", "label": "Tamaño título (px)", "min": 10, "max": 24, "step": 1, "default": 13 },
    { "type": "color", "id": "label_color", "label": "Color título", "default": "#1a1a18" },
    { "type": "range", "id": "label_gap", "label": "Espacio título-fotos (px)", "min": 4, "max": 32, "step": 2, "default": 12 },
    { "type": "range", "id": "per_view", "label": "Fotos visibles a la vez", "min": 1, "max": 4, "step": 1, "default": 2 },
    { "type": "range", "id": "photo_height", "label": "Alto de foto (px)", "min": 120, "max": 500, "step": 10, "default": 260 },
    { "type": "range", "id": "radius", "label": "Bordes redondeados (px)", "min": 0, "max": 24, "step": 2, "default": 8 },
    { "type": "range", "id": "gap", "label": "Espacio entre fotos (px)", "min": 4, "max": 24, "step": 2, "default": 8 },
    { "type": "range", "id": "speed", "label": "Velocidad auto-slide (seg)", "min": 2, "max": 10, "step": 1, "default": 4 },
    { "type": "color", "id": "bg_color", "label": "Fondo", "default": "#ffffff" },
    { "type": "range", "id": "pt", "label": "Espacio superior (px)", "min": 0, "max": 48, "step": 4, "default": 16 },
    { "type": "range", "id": "pb", "label": "Espacio inferior (px)", "min": 0, "max": 48, "step": 4, "default": 16 },
    { "type": "range", "id": "px", "label": "Margen lateral (px)", "min": 0, "max": 32, "step": 2, "default": 16 }
  ],
  "max_blocks": 20,
  "blocks": [
    {
      "type": "photo",
      "name": "Foto cliente",
      "settings": [
        { "type": "image_picker", "id": "photo", "label": "Foto" },
        { "type": "text", "id": "alt", "label": "Texto alternativo (opcional)" }
      ]
    }
  ],
  "presets": [{ "name": "Fotos Clientes" }]
}
{% endschema %}
