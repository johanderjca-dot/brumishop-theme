<style>
  .sp-wrap {
    background: {{ section.settings.bg_color }};
    padding: {{ section.settings.pt }}px 0 {{ section.settings.pb }}px;
    overflow: hidden;
  }
  .sp-header {
    text-align: center;
    padding: 0 16px;
    margin-bottom: {{ section.settings.header_gap }}px;
  }
  .sp-line1 {
    font-size: {{ section.settings.text_size }}px;
    color: {{ section.settings.text_color }};
    font-weight: 400;
    margin: 0 0 2px;
    line-height: 1.3;
  }
  .sp-number {
    font-size: {{ section.settings.number_size }}px;
    font-weight: 700;
    color: {{ section.settings.number_color }};
    line-height: 1.1;
    margin: 0 0 4px;
  }
  .sp-line2 {
    font-size: {{ section.settings.text_size }}px;
    color: {{ section.settings.text_color }};
    font-weight: 400;
    margin: 0;
    line-height: 1.3;
  }

  /* Marquee */
  .sp-marquee-wrap { display: flex; width: 100%; overflow: hidden; }
  .sp-marquee-track {
    display: flex;
    gap: {{ section.settings.media_gap }}px;
    animation: sp-scroll {{ section.settings.speed }}s linear infinite;
    will-change: transform;
  }
  .sp-marquee-track:hover { animation-play-state: paused; }
  @keyframes sp-scroll {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .sp-media-item {
    flex-shrink: 0;
    width: {{ section.settings.media_width }}px;
    height: {{ section.settings.media_height }}px;
    border-radius: {{ section.settings.media_radius }}px;
    overflow: hidden;
    display: block;
    background: #e8e8e2;
  }
  .sp-media-item img,
  .sp-media-item video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>

<div class="sp-wrap">

  <div class="sp-header">
    {% if section.settings.line1 != blank %}
      <p class="sp-line1">{{ section.settings.line1 }}</p>
    {% endif %}
    {% if section.settings.number != blank %}
      <p class="sp-number">{{ section.settings.number }}</p>
    {% endif %}
    {% if section.settings.line2 != blank %}
      <p class="sp-line2">{{ section.settings.line2 }}</p>
    {% endif %}
  </div>

  {% if section.blocks.size > 0 %}
    <div class="sp-marquee-wrap">
      <div class="sp-marquee-track">
        {% comment %}Doble loop para loop infinito{% endcomment %}
        {% for n in (1..2) %}
          {% for block in section.blocks %}
            <div class="sp-media-item" {{ block.shopify_attributes }}>
              {% if block.settings.video_url != blank %}
                <video autoplay muted loop playsinline>
                  <source src="{{ block.settings.video_url }}" type="video/mp4">
                </video>
              {% elsif block.settings.photo != blank %}
                <img src="{{ block.settings.photo | image_url: width: 400 }}"
                     alt="{{ block.settings.alt | default: '' | escape }}"
                     loading="lazy">
              {% endif %}
            </div>
          {% endfor %}
        {% endfor %}
      </div>
    </div>
  {% endif %}

</div>

{% schema %}
{
  "name": "Prueba Social",
  "settings": [
    { "type": "header", "content": "Mensaje" },
    { "type": "text", "id": "line1", "label": "Línea 1 (antes del número)", "default": "Ya son más de" },
    { "type": "text", "id": "number", "label": "Número destacado", "default": "+1,000", "info": "Ejemplo: +1,000 · 2,500 clientes · etc." },
    { "type": "text", "id": "line2", "label": "Línea 2 (después del número)", "default": "personas que lo están usando" },
    { "type": "range", "id": "text_size", "label": "Tamaño texto (px)", "min": 12, "max": 28, "step": 1, "default": 16 },
    { "type": "range", "id": "number_size", "label": "Tamaño número (px)", "min": 24, "max": 72, "step": 2, "default": 42 },
    { "type": "color", "id": "text_color", "label": "Color texto", "default": "#1a1a18" },
    { "type": "color", "id": "number_color", "label": "Color número", "default": "#2d7a3a" },
    { "type": "range", "id": "header_gap", "label": "Espacio mensaje-fotos (px)", "min": 8, "max": 48, "step": 4, "default": 20 },

    { "type": "header", "content": "Medios (fotos / GIFs / videos)" },
    { "type": "range", "id": "media_width", "label": "Ancho de cada item (px)", "min": 60, "max": 300, "step": 4, "default": 120 },
    { "type": "range", "id": "media_height", "label": "Alto de cada item (px)", "min": 60, "max": 400, "step": 4, "default": 160 },
    { "type": "range", "id": "media_radius", "label": "Bordes redondeados (px)", "min": 0, "max": 40, "step": 2, "default": 10 },
    { "type": "range", "id": "media_gap", "label": "Espacio entre items (px)", "min": 4, "max": 24, "step": 2, "default": 8 },
    { "type": "range", "id": "speed", "label": "Velocidad scroll (seg — más alto = más lento)", "min": 10, "max": 80, "step": 2, "default": 30 },

    { "type": "header", "content": "Fondo y espaciado" },
    { "type": "color", "id": "bg_color", "label": "Fondo", "default": "#ffffff" },
    { "type": "range", "id": "pt", "label": "Espacio superior (px)", "min": 0, "max": 64, "step": 4, "default": 24 },
    { "type": "range", "id": "pb", "label": "Espacio inferior (px)", "min": 0, "max": 64, "step": 4, "default": 24 }
  ],
  "max_blocks": 20,
  "blocks": [
    {
      "type": "media",
      "name": "Foto / GIF / Video",
      "settings": [
        { "type": "image_picker", "id": "photo", "label": "Foto o GIF", "info": "Sube tu imagen o GIF aquí" },
        { "type": "text", "id": "video_url", "label": "URL de video (opcional)", "info": "Sube el video a Shopify Files, copia la URL y pégala aquí. Si hay video, ignora la foto." },
        { "type": "text", "id": "alt", "label": "Texto alternativo (opcional)" }
      ]
    }
  ],
  "presets": [{ "name": "Prueba Social" }]
}
{% endschema %}
