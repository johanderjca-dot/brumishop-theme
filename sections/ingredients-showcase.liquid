<section class="ingredients section-pad" style="{% if section.settings.bg_color != blank %}background: {{ section.settings.bg_color }};{% endif %}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="ingredients__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="ingredients__layout">
      <div class="ingredients__col ingredients__col--left">
        {%- for block in section.blocks -%}
          {%- if forloop.index0 | modulo: 2 == 0 -%}
            <div class="ingredients__item" {{ block.shopify_attributes }}>
              {%- if block.settings.title != blank -%}<h3>{{ block.settings.title }}</h3>{%- endif -%}
              {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="ingredients__media">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 900 }}"
               srcset="{{ section.settings.image | image_url: width: 500 }} 500w, {{ section.settings.image | image_url: width: 900 }} 900w"
               sizes="(min-width: 750px) 30vw, 60vw"
               alt="{{ section.settings.heading | escape }}"
               width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}"
               loading="lazy">
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'ingredients__placeholder' }}
        {%- endif -%}
      </div>

      <div class="ingredients__col ingredients__col--right">
        {%- for block in section.blocks -%}
          {%- if forloop.index0 | modulo: 2 == 1 -%}
            <div class="ingredients__item" {{ block.shopify_attributes }}>
              {%- if block.settings.title != blank -%}<h3>{{ block.settings.title }}</h3>{%- endif -%}
              {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ingredientes clave",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "INGREDIENTES CLAVE" },
    { "type": "image_picker", "id": "image", "label": "Imagen central" },
    { "type": "color", "id": "bg_color", "label": "Color de fondo (opcional)" }
  ],
  "blocks": [
    { "type": "ingredient", "name": "Ingrediente", "settings": [
      { "type": "text", "id": "title", "label": "Título", "default": "Ingrediente" },
      { "type": "textarea", "id": "text", "label": "Descripción" }
    ]}
  ],
  "presets": [{
    "name": "Ingredientes clave",
    "blocks": [
      { "type": "ingredient" }, { "type": "ingredient" },
      { "type": "ingredient" }, { "type": "ingredient" },
      { "type": "ingredient" }, { "type": "ingredient" }
    ]
  }]
}
{% endschema %}
