<section class="max-w-[1320px] mx-auto px-6 py-10 pb-16">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

    {% for block in section.blocks %}
      <div class="feature-panel relative overflow-hidden rounded-sm group cursor-pointer" style="min-height: 380px; background: {{ block.settings.bg_color }};">
        {% if block.settings.image != blank %}
          <img src="{{ block.settings.image | image_url: width: 900 }}"
               alt="{{ block.settings.title }}"
               class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
               style="filter: contrast(1.1) saturate(0.8) brightness({{ block.settings.image_brightness | default: 0.88 }});">
        {% endif %}

        {% if block.settings.overlay %}
          <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(0,0,0,0.5), transparent);"></div>
        {% endif %}

        <div class="absolute bottom-0 left-0 p-8">
          {% if block.settings.eyebrow != blank %}
            <p class="text-[10px] font-bold tracking-[0.2em] uppercase mb-2" style="color: {{ block.settings.text_color }}; opacity: 0.7;">
              {{ block.settings.eyebrow }}
            </p>
          {% endif %}
          <h3 class="font-display text-3xl font-semibold leading-tight" style="color: {{ block.settings.text_color }};">
            {{ block.settings.title }}
          </h3>
          {% if block.settings.subtitle != blank %}
            <p class="mt-2 text-sm max-w-[200px] leading-relaxed" style="color: {{ block.settings.text_color }}; opacity: 0.7;">
              {{ block.settings.subtitle }}
            </p>
          {% endif %}
          {% if block.settings.button_label != blank %}
            <a href="{{ block.settings.button_url }}"
               class="mt-5 inline-block border text-xs font-semibold px-6 py-2.5 transition-all duration-200 hover:opacity-80"
               style="border-color: {{ block.settings.text_color }}; color: {{ block.settings.text_color }};">
              {{ block.settings.button_label }}
            </a>
          {% endif %}
        </div>
      </div>
    {% endfor %}

  </div>
</section>

{% schema %}
{
  "name": "Feature Banners",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "banner",
      "name": "Banner",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "color",
          "id": "bg_color",
          "label": "Background color",
          "default": "#C8D4B8"
        },
        {
          "type": "checkbox",
          "id": "overlay",
          "label": "Dark overlay on image",
          "default": true
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow text",
          "default": "Nueva Colección"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Descubre lo Último en Tendencia"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "default": "#ffffff"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button text",
          "default": "Explorar"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature Banners",
      "blocks": [
        {
          "type": "banner",
          "settings": {
            "eyebrow": "Nueva Colección",
            "title": "Descubre lo Último en Tendencia",
            "button_label": "Explorar",
            "text_color": "#ffffff",
            "overlay": true
          }
        },
        {
          "type": "banner",
          "settings": {
            "title": "25% off en Todo",
            "subtitle": "Cientos de productos con descuento. Oferta por tiempo limitado.",
            "button_label": "Ir a la Oferta",
            "text_color": "#1a2a0e",
            "bg_color": "#C8D4B8",
            "overlay": false
          }
        }
      ]
    }
  ]
}
{% endschema %}
