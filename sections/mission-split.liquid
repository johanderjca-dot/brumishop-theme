<section class="section-pad mission">
  <div class="page-width">
    <div class="mission__grid">
      <div class="mission__media">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 900 }}"
               srcset="{{ section.settings.image | image_url: width: 500 }} 500w, {{ section.settings.image | image_url: width: 900 }} 900w"
               sizes="(min-width: 990px) 45vw, 90vw"
               alt="{{ section.settings.heading | escape }}"
               width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}"
               loading="lazy">
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag }}
        {%- endif -%}
      </div>

      <div class="mission__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="mission__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="mission__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="mission__list">
            {%- for block in section.blocks -%}
              <li class="mission__item" {{ block.shopify_attributes }}>
                <span class="mission__check">{% render 'icon-checkmark' %}</span>
                <span>{{ block.settings.text }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.link_label != blank -%}
          <a class="mission__link" href="{{ section.settings.link_url | default: '#' }}">{{ section.settings.link_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Nuestra misión",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen" },
    { "type": "text", "id": "eyebrow", "label": "Etiqueta pequeña", "default": "Nuestra misión" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Hay ciencia detrás de la ciencia." },
    { "type": "text", "id": "link_label", "label": "Texto del enlace", "default": "Leer más" },
    { "type": "url", "id": "link_url", "label": "Enlace" }
  ],
  "blocks": [
    { "type": "item", "name": "Punto", "settings": [
      { "type": "text", "id": "text", "label": "Texto", "default": "Un beneficio o valor de tu marca." }
    ]}
  ],
  "presets": [{
    "name": "Nuestra misión",
    "blocks": [ { "type": "item" }, { "type": "item" }, { "type": "item" } ]
  }]
}
{% endschema %}
