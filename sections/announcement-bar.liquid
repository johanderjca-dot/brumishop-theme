{% assign is_product_page = false %}
{% if template contains 'product' %}
  {% assign is_product_page = true %}
{% endif %}

{% if section.settings.text != blank and is_product_page == false %}
<style>
  @keyframes ab-scroll {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .ab-track {
    display: flex;
    white-space: nowrap;
    animation: ab-scroll {{ section.settings.speed }}s linear infinite;
  }
  .ab-track:hover { animation-play-state: paused; }
  .ab-item {
    display: inline-block;
    padding: 0 3rem;
    font-size: {{ section.settings.font_size }}px;
    color: {{ section.settings.text_color }};
    font-weight: {% if section.settings.bold %}700{% else %}500{% endif %};
    font-style: {% if section.settings.italic %}italic{% else %}normal{% endif %};
    letter-spacing: 0.{{ section.settings.letter_spacing }}em;
    text-transform: {% if section.settings.uppercase %}uppercase{% else %}none{% endif %};
  }
</style>

<div style="background:{{ section.settings.bg_color }}; padding:{{ section.settings.py }}px 0; overflow:hidden;">
  <div class="ab-track">
    {% for i in (1..6) %}
      <span class="ab-item">{{ section.settings.text }}</span>
    {% endfor %}
  </div>
</div>
{% endif %}

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Texto",
      "default": "ENVÍO GRATIS EN PEDIDOS MAYORES A $50  ·  NUEVOS PRODUCTOS CADA SEMANA"
    },
    {
      "type": "checkbox",
      "id": "bold",
      "label": "Negrita",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "italic",
      "label": "Cursiva",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "uppercase",
      "label": "Mayúsculas",
      "default": true
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Tamaño del texto (px)",
      "min": 10,
      "max": 20,
      "step": 1,
      "default": 12
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Espaciado entre letras",
      "min": 0,
      "max": 9,
      "step": 1,
      "default": 1,
      "info": "0 = normal, 9 = muy amplio"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Velocidad del scroll (seg) — menor = más rápido",
      "min": 10,
      "max": 60,
      "step": 5,
      "default": 25
    },
    {
      "type": "range",
      "id": "py",
      "label": "Espacio vertical (px)",
      "min": 4,
      "max": 24,
      "step": 2,
      "default": 10
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de fondo",
      "default": "#F2EBC4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color del texto",
      "default": "#1a1a18"
    }
  ],
  "presets": [{ "name": "Announcement Bar" }]
}
{% endschema %}