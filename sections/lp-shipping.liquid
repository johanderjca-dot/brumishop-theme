<style>
  .lp-shipping-accordion { border-bottom: 1px solid var(--ship-border); }
  .lp-shipping-accordion summary { cursor: pointer; list-style: none; }
  .lp-shipping-accordion summary::-webkit-details-marker { display: none; }
  .lp-shipping-accordion[open] .lp-ship-arrow { transform: rotate(180deg); }
  .lp-ship-arrow { transition: transform .25s ease; display: inline-block; }
</style>

{% if section.blocks.size > 0 %}
<section style="--ship-border:{{ section.settings.border_color }}; background:{{ section.settings.bg_color }}; padding:{{ section.settings.py }}px 0;">
  <div style="max-width:{{ section.settings.max_width }}px; margin:0 auto; padding:0 1.5rem;">

    <details class="lp-shipping-accordion" style="border-top:1px solid {{ section.settings.border_color }};">
      <summary style="padding:1.1rem 0; display:flex; align-items:center; justify-content:space-between;">
        <span style="font-size:0.9rem; font-weight:600; color:{{ section.settings.heading_color }};">
          {% if section.settings.icon != blank %}{{ section.settings.icon }}&nbsp;&nbsp;{% endif %}{{ section.settings.title }}
        </span>
        <span class="lp-ship-arrow" style="color:{{ section.settings.text_color }}; font-size:0.8rem;">▼</span>
      </summary>

      <div style="padding:0.25rem 0 1.5rem;">
        {% for block in section.blocks %}
          <div {{ block.shopify_attributes }}
               style="display:flex; align-items:flex-start; gap:1rem; padding:0.75rem 0; {% unless forloop.last %}border-bottom:1px solid {{ section.settings.border_color }};{% endunless %}">
            {% if block.settings.icon != blank %}
              <div style="font-size:1.5rem; line-height:1; flex-shrink:0; color:{{ section.settings.icon_color }};">{{ block.settings.icon }}</div>
            {% endif %}
            <div>
              {% if block.settings.title != blank %}
                <p style="font-weight:700; font-size:0.875rem; color:{{ section.settings.heading_color }}; margin:0 0 0.25rem;">{{ block.settings.title }}</p>
              {% endif %}
              {% if block.settings.description != blank %}
                <p style="font-size:0.8rem; color:{{ section.settings.text_color }}; line-height:1.6; margin:0;">{{ block.settings.description }}</p>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </details>

  </div>
</section>
{% endif %}

{% schema %}
{
  "name": "6 — Información de Envío",
  "settings": [
    { "type": "text", "id": "icon", "label": "Ícono del título (emoji)", "default": "🚚" },
    { "type": "text", "id": "title", "label": "Título del acordeón", "default": "Información de envío" },
    { "type": "range", "id": "max_width", "label": "Ancho máximo (px)", "min": 400, "max": 1100, "step": 20, "default": 780 },
    { "type": "range", "id": "py", "label": "Espacio vertical (px)", "min": 0, "max": 80, "step": 4, "default": 0 },
    { "type": "color", "id": "bg_color", "label": "Fondo", "default": "#FFFFFF" },
    { "type": "color", "id": "border_color", "label": "Color bordes", "default": "#E8E8E2" },
    { "type": "color", "id": "icon_color", "label": "Color íconos items", "default": "#5a7a40" },
    { "type": "color", "id": "heading_color", "label": "Color títulos", "default": "#1a1a18" },
    { "type": "color", "id": "text_color", "label": "Color texto", "default": "#6a6a62" }
  ],
  "max_blocks": 8,
  "blocks": [
    {
      "type": "item",
      "name": "Item de envío",
      "settings": [
        { "type": "text", "id": "icon", "label": "Ícono o emoji", "default": "📦" },
        { "type": "text", "id": "title", "label": "Título", "default": "Envío gratis" },
        { "type": "textarea", "id": "description", "label": "Descripción", "default": "Entrega en 3-5 días hábiles a todo el país." }
      ]
    }
  ],
  "presets": [{
    "name": "6 — Información de Envío",
    "blocks": [
      { "type": "item", "settings": { "icon": "🚚", "title": "Envío gratis", "description": "Entrega a todo RD sin costo adicional." } },
      { "type": "item", "settings": { "icon": "📦", "title": "Empaque seguro", "description": "Todos los productos van bien empacados para llegar en perfectas condiciones." } },
      { "type": "item", "settings": { "icon": "📍", "title": "Rastreo de pedido", "description": "Te notificamos por WhatsApp cuando tu pedido esté en camino." } }
    ]
  }]
}
{% endschema %}
