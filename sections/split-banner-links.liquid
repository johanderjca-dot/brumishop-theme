<section class="split-banner">
  {%- for block in section.blocks -%}
    <a class="split-banner__panel" href="{{ block.settings.url | default: '#' }}" {{ block.shopify_attributes }}>
      {%- if block.settings.image != blank -%}
        <img src="{{ block.settings.image | image_url: width: 1000 }}"
             srcset="{{ block.settings.image | image_url: width: 500 }} 500w, {{ block.settings.image | image_url: width: 1000 }} 1000w"
             sizes="(min-width: 750px) 50vw, 100vw"
             alt="{{ block.settings.heading | escape }}"
             width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}"
             loading="lazy">
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'split-banner__placeholder' }}
      {%- endif -%}
      <div class="split-banner__overlay"></div>
      <div class="split-banner__content">
        {%- if block.settings.heading != blank -%}
          <span class="split-banner__heading">{{ block.settings.heading }}</span>
        {%- endif -%}
        {%- if block.settings.link_label != blank -%}
          <span class="split-banner__link">{{ block.settings.link_label }}</span>
        {%- endif -%}
      </div>
    </a>
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "Banner doble con enlaces",
  "tag": "section",
  "blocks": [
    { "type": "panel", "name": "Panel", "settings": [
      { "type": "image_picker", "id": "image", "label": "Imagen" },
      { "type": "text", "id": "heading", "label": "Título", "default": "Título" },
      { "type": "text", "id": "link_label", "label": "Texto del enlace", "default": "Ver ahora" },
      { "type": "url", "id": "url", "label": "Enlace" }
    ]}
  ],
  "presets": [{
    "name": "Banner doble con enlaces",
    "blocks": [ { "type": "panel" }, { "type": "panel" } ]
  }]
}
{% endschema %}
