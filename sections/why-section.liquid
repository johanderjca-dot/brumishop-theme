<section class="why section-pad" style="{% if section.settings.bg_color != blank %}background: {{ section.settings.bg_color }};{% endif %}{% if section.settings.text_color != blank %} color: {{ section.settings.text_color }};{% endif %}">
  <div class="page-width why__grid">
    <div class="why__media">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 900 }}"
             srcset="{{ section.settings.image | image_url: width: 500 }} 500w, {{ section.settings.image | image_url: width: 900 }} 900w"
             sizes="(min-width: 750px) 45vw, 90vw"
             alt="{{ section.settings.heading | escape }}"
             width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}"
             loading="lazy">
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'why__placeholder' }}
      {%- endif -%}
    </div>

    <div class="why__content">
      {%- if section.settings.heading != blank -%}<h2 class="why__heading">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="why__text rte">{{ section.settings.text }}</div>{%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="why__table">
          <div class="why__table-head">
            <span>{{ section.settings.col1_label }}</span>
            <span>{{ section.settings.col2_label }}</span>
          </div>
          {%- for block in section.blocks -%}
            <div class="why__table-row" {{ block.shopify_attributes }}>
              <span>{{ block.settings.benefit }}</span>
              <span class="why__included">✓ {{ section.settings.included_label }}</span>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.guarantee != blank -%}
        <p class="why__guarantee">{% render 'icon-checkmark' %} {{ section.settings.guarantee }}</p>
      {%- endif -%}

      {%- if section.settings.btn_label != blank -%}
        <div class="why__cta">
          <a class="btn btn--primary" href="#comprar">{{ section.settings.btn_label }}</a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Por qué este producto",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen" },
    { "type": "text", "id": "heading", "label": "Título", "default": "¿POR QUÉ ESTE PRODUCTO?" },
    { "type": "richtext", "id": "text", "label": "Descripción" },
    { "type": "text", "id": "col1_label", "label": "Columna 1", "default": "Beneficio:" },
    { "type": "text", "id": "col2_label", "label": "Columna 2", "default": "Cápsulas:" },
    { "type": "text", "id": "included_label", "label": "Texto de \"incluido\"", "default": "Incluido" },
    { "type": "text", "id": "guarantee", "label": "Texto de garantía (opcional)", "default": "Garantía de devolución de 30 días" },
    { "type": "text", "id": "btn_label", "label": "Texto del botón (opcional)", "info": "Lleva a la caja de compra (#comprar), donde está el botón real de Releasit." },
    { "type": "color", "id": "bg_color", "label": "Color de fondo (opcional)" },
    { "type": "color", "id": "text_color", "label": "Color del texto (opcional)" }
  ],
  "blocks": [
    { "type": "row", "name": "Beneficio", "settings": [
      { "type": "text", "id": "benefit", "label": "Texto", "default": "Beneficio" }
    ]}
  ],
  "presets": [{
    "name": "Por qué este producto",
    "blocks": [ { "type": "row" }, { "type": "row" }, { "type": "row" }, { "type": "row" } ]
  }]
}
{% endschema %}
