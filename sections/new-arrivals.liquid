{%- paginate collections.all.products by 250 -%}
  {%- assign newest_products = collections.all.products | sort: 'created_at' | reverse -%}
  <section class="section-pad" id="{{ section.settings.anchor }}">
    <div class="page-width">
      <div class="section-head-row">
        {%- if section.settings.heading != blank -%}<h2 class="h2">{{ section.settings.heading }}</h2>{%- endif -%}
        <a class="link-more" href="{{ routes.all_products_collection_url }}">Ver todo →</a>
      </div>
      <div class="grid grid--{{ section.settings.columns }}">
        {%- for product in newest_products limit: section.settings.limit -%}
          {% render 'product-card', product: product %}
        {%- else -%}
          {%- for i in (1..4) -%}
            <div class="card">{{ 'product-1' | placeholder_svg_tag }}</div>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Nuevos productos",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Nuevos productos" },
    { "type": "text", "id": "anchor", "label": "Ancla (para enlazar botones a esta sección)", "default": "nuevos" },
    { "type": "range", "id": "limit", "min": 2, "max": 12, "step": 1, "label": "Cuántos productos", "default": 8 },
    { "type": "range", "id": "columns", "min": 2, "max": 5, "step": 1, "label": "Columnas en escritorio", "default": 4 }
  ],
  "presets": [{ "name": "Nuevos productos" }]
}
{% endschema %}
