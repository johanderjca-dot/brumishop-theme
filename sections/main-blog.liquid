<section class="page-width section-pad">
  <h1 class="h1">{{ blog.title }}</h1>
  <div class="grid grid--3">
    {%- for article in blog.articles -%}
      <a class="card" href="{{ article.url }}">
        {%- if article.image -%}<img src="{{ article.image | image_url: width: 600 }}" alt="" width="400" height="260" loading="lazy">{%- endif -%}
        <h3>{{ article.title }}</h3>
        <p>{{ article.excerpt_or_content | strip_html | truncate: 110 }}</p>
      </a>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{ "name": "Blog" }
{% endschema %}
