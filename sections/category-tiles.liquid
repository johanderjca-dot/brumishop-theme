<section class="section-pad">
  <div class="page-width">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="cat-head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="cat-head__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="cat-head__title">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="tiles-carousel" data-tiles-carousel style="--tiles-cols: {{ section.settings.columns }}">
      <div class="tiles-carousel__track" data-tiles-track>
        {%- for block in section.blocks -%}
          <a class="tile{% if block.settings.image_hover != blank %} tile--has-hover{% endif %}" href="{{ block.settings.url | default: '#' }}" {{ block.shopify_attributes }}>
            <div class="tile__media">
              {%- if block.settings.image != blank -%}
                <img class="tile__img tile__img--base"
                     src="{{ block.settings.image | image_url: width: 900 }}"
                     srcset="{{ block.settings.image | image_url: width: 450 }} 450w, {{ block.settings.image | image_url: width: 900 }} 900w"
                     sizes="(min-width: 990px) 33vw, 90vw"
                     alt="{{ block.settings.title | escape }}"
                     width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" loading="lazy">
              {%- else -%}
                {{ 'collection-2' | placeholder_svg_tag: 'tile__img tile__img--base' }}
              {%- endif -%}
              {%- if block.settings.image_hover != blank -%}
                <img class="tile__img tile__img--hover"
                     src="{{ block.settings.image_hover | image_url: width: 900 }}"
                     srcset="{{ block.settings.image_hover | image_url: width: 450 }} 450w, {{ block.settings.image_hover | image_url: width: 900 }} 900w"
                     sizes="(min-width: 990px) 33vw, 90vw"
                     alt=""
                     width="{{ block.settings.image_hover.width }}" height="{{ block.settings.image_hover.height }}" loading="lazy">
              {%- endif -%}
            </div>
            <div class="tile__body">
              <span class="tile__title">{{ block.settings.title }}</span>
              {%- if block.settings.cta != blank -%}<span class="tile__cta">{{ block.settings.cta }} →</span>{%- endif -%}
            </div>
          </a>
        {%- endfor -%}
      </div>

      <button class="tiles-carousel__nav tiles-carousel__nav--prev" type="button" data-tiles-prev aria-label="Categoría anterior">{% render 'icon-caret' %}</button>
      <button class="tiles-carousel__nav tiles-carousel__nav--next" type="button" data-tiles-next aria-label="Siguiente categoría">{% render 'icon-caret' %}</button>
    </div>

    {%- if section.settings.show_view_all -%}
      <div class="cat-viewall">
        <a class="cat-viewall__link" href="{{ section.settings.view_all_url | default: routes.collections_url }}">
          {{ section.settings.view_all_label | default: 'Ver todo' }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Mosaico de categorías",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Etiqueta pequeña (opcional)", "default": "Descubre" },
    { "type": "text", "id": "heading", "label": "Título de la sección", "default": "Compra por categoría" },
    { "type": "range", "id": "columns", "min": 2, "max": 5, "step": 1, "label": "Tarjetas visibles en escritorio", "default": 5, "info": "El resto se desliza en el carrusel." },

    { "type": "header", "content": "\"Ver todo\"" },
    { "type": "checkbox", "id": "show_view_all", "label": "Mostrar enlace \"Ver todo\" al final", "default": true },
    { "type": "text", "id": "view_all_label", "label": "Texto", "default": "Ver todo" },
    { "type": "url", "id": "view_all_url", "label": "Enlace (opcional)", "info": "Si lo dejas vacío, enlaza a la página de todas las colecciones." }
  ],
  "blocks": [
    { "type": "tile", "name": "Categoría", "settings": [
      { "type": "image_picker", "id": "image", "label": "Imagen" },
      { "type": "image_picker", "id": "image_hover", "label": "Imagen al pasar el cursor (opcional)", "info": "Si la subes, la imagen cambia a esta al pasar el cursor (o al tocar en móvil). El título y el enlace siempre muestran la categoría, nunca un producto." },
      { "type": "text", "id": "title", "label": "Título", "default": "Belleza" },
      { "type": "text", "id": "cta", "label": "Llamada", "default": "Ver" },
      { "type": "url", "id": "url", "label": "Enlace" }
    ]}
  ],
  "presets": [{
    "name": "Mosaico de categorías",
    "blocks": [ { "type": "tile" }, { "type": "tile" }, { "type": "tile" } ]
  }]
}
{% endschema %}
