<div class="border-y border-[#E8E8E2] bg-[#FAFAF6] py-6">
  <div class="max-w-[1320px] mx-auto px-6 grid grid-cols-2 md:grid-cols-4 gap-4">
    {% for block in section.blocks %}
      <div class="flex items-center gap-3">
        <span class="text-lg" style="color: {{ section.settings.icon_color }};">{{ block.settings.icon }}</span>
        <span class="text-xs font-medium text-[#5a5a52]">{{ block.settings.text }}</span>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Trust Bar",
  "settings": [
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#5a7a40"
    }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (symbol)",
          "default": "○"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Envío gratis desde $50"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Bar",
      "blocks": [
        { "type": "item", "settings": { "icon": "○", "text": "Envío gratis desde $50" } },
        { "type": "item", "settings": { "icon": "◇", "text": "Devoluciones en 30 días" } },
        { "type": "item", "settings": { "icon": "△", "text": "Pagos 100% seguros" } },
        { "type": "item", "settings": { "icon": "□", "text": "Soporte 24/7" } }
      ]
    }
  ]
}
{% endschema %}
