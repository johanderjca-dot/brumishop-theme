{% if section.settings.image != blank %}
<div style="border-top:1px solid {{ section.settings.border_color }}; border-bottom:1px solid {{ section.settings.border_color }}; background:{{ section.settings.bg_color }}; padding:{{ section.settings.py }}px 0; text-align:center;">
  <img src="{{ section.settings.image | image_url: width: 1400 }}"
       alt="{{ section.settings.image.alt | default: 'Trust badges' | escape }}"
       style="max-width:{{ section.settings.max_width }}px; width:100%; height:auto; display:inline-block;"
       loading="lazy">
</div>
{% endif %}

{% schema %}
{
  "name": "Trust Bar",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen de badges"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Ancho máximo de la imagen (px)",
      "min": 200,
      "max": 1200,
      "step": 50,
      "default": 900
    },
    {
      "type": "range",
      "id": "py",
      "label": "Espacio vertical (px)",
      "min": 8,
      "max": 64,
      "step": 4,
      "default": 20
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de fondo",
      "default": "#FAFAF6"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Color del borde",
      "default": "#E8E8E2"
    }
  ],
  "presets": [
    {
      "name": "Trust Bar"
    }
  ]
}
{% endschema %}
