<div style="border-top:1px solid {{ section.settings.border_color }}; border-bottom:1px solid {{ section.settings.border_color }}; background:{{ section.settings.bg_color }}; padding:1.5rem 0;">
  <div class="max-w-[1320px] mx-auto px-6 grid grid-cols-2 md:grid-cols-4 gap-4">
    {% for block in section.blocks %}
      <div class="flex items-center gap-3">
        <span style="font-size:1.125rem; color:{{ section.settings.icon_color }};">{{ block.settings.icon }}</span>
        <span style="font-size:0.75rem; font-weight:500; color:{{ section.settings.text_color }};">{{ block.settings.text }}</span>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Trust Bar",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de fondo",
      "default": "#FAFAF6"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Color del borde",
      "default": "#E8E8E2"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Color del ícono",
      "default": "#5a7a40"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color del texto",
      "default": "#5a5a52"
    }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (symbol)",
          "default": "○"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Envío gratis desde $50"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Bar",
      "blocks": [
        { "type": "item", "settings": { "icon": "○", "text": "Envío gratis desde $50" } },
        { "type": "item", "settings": { "icon": "◇", "text": "Devoluciones en 30 días" } },
        { "type": "item", "settings": { "icon": "△", "text": "Pagos 100% seguros" } },
        { "type": "item", "settings": { "icon": "□", "text": "Soporte 24/7" } }
      ]
    }
  ]
}
{% endschema %}
