<style>
  .lp-desc-content p { margin-bottom: 0.25rem; line-height: 1.5; }
  .lp-desc-content p:last-child { margin-bottom: 0; }
  .lp-desc-content ul, .lp-desc-content ol { margin: 0.5rem 0 0.75rem 1.5rem; line-height: 1.75; }
  .lp-desc-content li { margin-bottom: 0.25rem; }
  .lp-desc-content strong { color: inherit; }
</style>

<section style="background:{{ section.settings.bg_color }}; padding:{{ section.settings.pt }}px {{ section.settings.px }}px {{ section.settings.pb }}px;">
  <div style="max-width:{{ section.settings.max_width }}px; margin:0 auto;
              background:{{ section.settings.box_bg }};
              border:{{ section.settings.border_width }}px solid {{ section.settings.border_color }};
              border-radius:{{ section.settings.radius }}px;
              padding:{{ section.settings.box_pad }}px;
              text-align:{{ section.settings.align }};">
    {% if section.settings.title != blank %}
      <div style="font-size:{{ section.settings.title_size }}px; font-weight:{{ section.settings.title_weight }}; color:{{ section.settings.title_color }}; margin-bottom:{{ section.settings.title_gap }}px; line-height:1.2;">
        {{ section.settings.title }}
      </div>
    {% endif %}
    <div class="lp-desc-content" style="font-size:{{ section.settings.font_size }}px; color:{{ section.settings.text_color }}; font-family:{{ section.settings.font_family }};">
      {% if section.settings.content != blank %}
        {{ section.settings.content }}
      {% elsif product.description != blank %}
        {{ product.description }}
      {% endif %}
    </div>
    {% if section.settings.rating_text != blank %}
      <a href="#resenas" style="display:inline-flex; align-items:center; gap:6px; text-decoration:none; margin-top:{{ section.settings.rating_gap }}px;">
        <span style="color:{{ section.settings.star_color }}; font-size:{{ section.settings.star_size }}px; letter-spacing:2px; line-height:1;">★★★★★</span>
        <em style="font-size:{{ section.settings.star_size | minus: 2 }}px; color:#6a6a62; font-style:italic;">{{ section.settings.rating_text }}</em>
      </a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "2 — Descripción",
  "settings": [
    { "type": "header", "content": "Título" },
    { "type": "text", "id": "title", "label": "Título (opcional)" },
    { "type": "range", "id": "title_size", "label": "Tamaño del título (px)", "min": 14, "max": 48, "step": 1, "default": 22 },
    { "type": "color", "id": "title_color", "label": "Color del título", "default": "#1a1a18" },
    { "type": "select", "id": "title_weight", "label": "Peso del título", "options": [{"value":"400","label":"Normal"},{"value":"600","label":"Semi-bold"},{"value":"700","label":"Bold"}], "default": "700" },
    { "type": "range", "id": "title_gap", "label": "Espacio título-texto (px)", "min": 4, "max": 32, "step": 2, "default": 8 },
    { "type": "header", "content": "Reseñas" },
    { "type": "text", "id": "rating_text", "label": "Texto de reseñas (ej: 127 reseñas)", "info": "Las ★★★★★ se ponen solas. Escribe solo el texto, ej: 127 reseñas. Vacío = oculto." },
    { "type": "range", "id": "star_size", "label": "Tamaño (px)", "min": 10, "max": 28, "step": 1, "default": 14 },
    { "type": "color", "id": "star_color", "label": "Color estrellas", "default": "#F4A327" },
    { "type": "range", "id": "rating_gap", "label": "Espacio encima (px)", "min": 0, "max": 32, "step": 2, "default": 8 },
    { "type": "header", "content": "Contenido" },
    {
      "type": "richtext",
      "id": "content",
      "label": "Contenido (vacío = usa descripción de Shopify)"
    },
    {
      "type": "select",
      "id": "font_family",
      "label": "Fuente",
      "options": [
        { "value": "'DM Sans', sans-serif", "label": "DM Sans (default)" },
        { "value": "'Sackers Gothic', sans-serif", "label": "Sackers Gothic" },
        { "value": "'Cormorant Garamond', Georgia, serif", "label": "Cormorant Garamond" }
      ],
      "default": "'DM Sans', sans-serif"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Alineación",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Derecha" },
        { "value": "justify", "label": "Justificado (extremo a extremo)" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Tamaño de texto (px)",
      "min": 12,
      "max": 24,
      "step": 1,
      "default": 15
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Ancho máximo (px)",
      "min": 300,
      "max": 1200,
      "step": 20,
      "default": 780
    },
    {
      "type": "range",
      "id": "px",
      "label": "Margen lateral (px)",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 16
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Espacio superior (px)",
      "min": 0,
      "max": 64,
      "step": 4,
      "default": 16
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Espacio inferior (px)",
      "min": 0,
      "max": 64,
      "step": 4,
      "default": 16
    },
    {
      "type": "range",
      "id": "box_pad",
      "label": "Padding del box (px)",
      "min": 0,
      "max": 48,
      "step": 4,
      "default": 20
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Bordes redondeados (px)",
      "min": 0,
      "max": 24,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Grosor del borde (px)",
      "min": 0,
      "max": 4,
      "step": 1,
      "default": 0
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Fondo sección",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "box_bg",
      "label": "Fondo del box",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Color del borde",
      "default": "#e8e8e2"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color del texto",
      "default": "#1a1a18"
    }
  ],
  "presets": [{ "name": "2 — Descripción" }]
}
{% endschema %}
