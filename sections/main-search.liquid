<section class="page-width section-pad">
  <h1 class="h1">Buscar</h1>
  <form action="{{ routes.search_url }}" method="get" class="search-form" role="search">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="¿Qué estás buscando?" aria-label="Buscar">
    <button class="btn btn--primary" type="submit">Buscar</button>
  </form>
  {%- if search.performed -%}
    <p class="search-count">{{ search.results_count }} resultado(s)</p>
    <div class="grid grid--4">
      {%- for item in search.results -%}
        {%- if item.object_type == 'product' -%}{% render 'product-card', product: item %}{%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>
{% schema %}
{ "name": "Búsqueda" }
{% endschema %}
