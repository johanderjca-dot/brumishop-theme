{%- paginate collection.products by 24 -%}
<section class="collection page-width">
  {%- if section.settings.show_title or collection.description != blank -%}
    <header class="collection__head">
      {%- if section.settings.show_title -%}<h1>{{ collection.title }}</h1>{%- endif -%}
      {%- if collection.description != blank -%}
        <div class="rte collection__desc">{{ collection.description }}</div>
      {%- endif -%}
    </header>
  {%- endif -%}

  <div class="collection__toolbar">
    <span class="collection__count">{{ paginate.items }} producto{% if paginate.items != 1 %}s{% endif %}</span>

    <form class="collection__sort" method="get" action="{{ collection.url }}" data-collection-sort>
      {%- for filter in collection.filters -%}
        {%- for value in filter.active_values -%}
          <input type="hidden" name="{{ filter.param_name }}" value="{{ value.value }}">
        {%- endfor -%}
      {%- endfor -%}
      <label>
        <span>Ordenar por:</span>
        <select name="sort_by" data-sort-select>
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>{{ option.name }}</option>
          {%- endfor -%}
        </select>
      </label>
    </form>
  </div>

  <div class="collection__layout">
    <div class="grid grid--{{ section.settings.columns }} collection__grid">
      {%- for product in collection.products -%}
        {% render 'product-card', product: product %}
      {%- else -%}
        <p class="collection__empty">No hay productos en esta colección todavía.</p>
      {%- endfor -%}
    </div>
  </div>

  {%- if paginate.pages > 1 -%}
    <nav class="pagination">
      {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">← Anterior</a>{%- endif -%}
      {%- if paginate.next -%}<a href="{{ paginate.next.url }}">Siguiente →</a>{%- endif -%}
    </nav>
  {%- endif -%}
</section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Colección",
  "settings": [
    { "type": "checkbox", "id": "show_title", "label": "Mostrar título de la colección", "default": true, "info": "Desactívalo si ya pusiste el título en el video de portada arriba." },
    { "type": "range", "id": "columns", "min": 2, "max": 5, "step": 1, "label": "Columnas en escritorio", "default": 4 }
  ]
}
{% endschema %}
