{%- paginate collection.products by 24 -%}
<section class="collection page-width">
  {%- if section.settings.show_title or collection.description != blank -%}
    <header class="collection__head">
      {%- if section.settings.show_title -%}<h1>{{ collection.title }}</h1>{%- endif -%}
      {%- if collection.description != blank -%}
        <div class="rte collection__desc">{{ collection.description }}</div>
      {%- endif -%}
    </header>
  {%- endif -%}

  <div class="collection__toolbar">
    <span class="collection__count">{{ paginate.items }} producto{% if paginate.items != 1 %}s{% endif %}</span>

    <form class="collection__sort" method="get" action="{{ collection.url }}" data-collection-sort>
      {%- for filter in collection.filters -%}
        {%- for value in filter.active_values -%}
          <input type="hidden" name="{{ filter.param_name }}" value="{{ value.value }}">
        {%- endfor -%}
      {%- endfor -%}
      <label>
        <span>Ordenar por:</span>
        <select name="sort_by" data-sort-select>
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>{{ option.name }}</option>
          {%- endfor -%}
        </select>
      </label>
    </form>

    {%- if collection.filters.size > 0 -%}
      <button type="button" class="collection__filters-toggle" data-filters-toggle>Filtrar</button>
    {%- endif -%}
  </div>

  <div class="collection__layout">
    {%- if collection.filters.size > 0 -%}
      {%- liquid
        assign any_filter_active = false
        for filter in collection.filters
          if filter.active_values.size > 0 or filter.min_value.value != nil or filter.max_value.value != nil
            assign any_filter_active = true
          endif
        endfor
      -%}
      <aside class="collection__filters" data-filters-panel hidden>
        <form method="get" action="{{ collection.url }}">
          <input type="hidden" name="sort_by" value="{{ collection.sort_by }}">
          {%- for filter in collection.filters -%}
            <div class="collection__filter-group">
              <p class="collection__filter-label">{{ filter.label }}</p>

              {%- case filter.type -%}

                {%- when 'price_range' -%}
                  <div class="collection__filter-price">
                    <input type="number" name="{{ filter.min_value.param_name }}" placeholder="Mín." value="{{ filter.min_value.value }}" min="0">
                    <input type="number" name="{{ filter.max_value.param_name }}" placeholder="Máx." value="{{ filter.max_value.value }}" min="0">
                  </div>

                {%- else -%}
                  <div class="collection__filter-options">
                    {%- for value in filter.values -%}
                      <label class="collection__filter-option{% if value.count == 0 and value.active == false %} is-disabled{% endif %}">
                        <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}>
                        <span>{{ value.label }} ({{ value.count }})</span>
                      </label>
                    {%- endfor -%}
                  </div>

              {%- endcase -%}
            </div>
          {%- endfor -%}

          <button type="submit" class="btn btn--primary btn--full">Aplicar filtros</button>
          {%- if any_filter_active -%}
            <a class="collection__filters-clear" href="{{ collection.url }}">Quitar filtros</a>
          {%- endif -%}
        </form>
      </aside>
    {%- endif -%}

    <div class="grid grid--{{ section.settings.columns }} collection__grid">
      {%- for product in collection.products -%}
        {% render 'product-card', product: product %}
      {%- else -%}
        <p>No hay productos en esta colección todavía.</p>
      {%- endfor -%}
    </div>
  </div>

  {%- if paginate.pages > 1 -%}
    <nav class="pagination">
      {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">← Anterior</a>{%- endif -%}
      {%- if paginate.next -%}<a href="{{ paginate.next.url }}">Siguiente →</a>{%- endif -%}
    </nav>
  {%- endif -%}
</section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Colección",
  "settings": [
    { "type": "checkbox", "id": "show_title", "label": "Mostrar título de la colección", "default": true, "info": "Desactívalo si ya pusiste el título en el video de portada arriba." },
    { "type": "range", "id": "columns", "min": 2, "max": 5, "step": 1, "label": "Columnas en escritorio", "default": 4 }
  ]
}
{% endschema %}
