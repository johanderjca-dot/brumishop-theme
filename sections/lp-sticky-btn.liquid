{% assign cv = product.selected_or_first_available_variant %}

<style>
  body { padding-bottom: {{ section.settings.bar_height }}px !important; }
</style>

<div id="lp-sticky-bar" style="
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 9998;
  background: {{ section.settings.bar_bg }};
  padding: {{ section.settings.bar_py }}px {{ section.settings.bar_px }}px;
  box-shadow: 0 -2px 20px rgba(0,0,0,0.12);
  text-align: center;
">
  <button id="lp-sticky-buy" style="
    background: {{ section.settings.btn_bg }};
    color: {{ section.settings.btn_color }};
    font-size: {{ section.settings.btn_font_size }}px;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: {{ section.settings.btn_py }}px {{ section.settings.btn_px }}px;
    border: none;
    border-radius: {{ section.settings.btn_radius }}px;
    cursor: pointer;
    width: 100%;
    max-width: {{ section.settings.btn_max_width }}px;
    transition: opacity .15s, transform 160ms cubic-bezier(0.23,1,0.32,1);
  "
  onmouseover="this.style.opacity='0.88'"
  onmouseout="this.style.opacity='1'"
  onmousedown="this.style.transform='scale(0.97)'"
  onmouseup="this.style.transform='scale(1)'">
    {{ section.settings.btn_text }}
  </button>
</div>

<script>
(function() {
  var btn = document.getElementById('lp-sticky-buy');
  if (!btn) return;

  var riBtn = null;

  // Busca el botón de Releaseit en el DOM
  function findRiBtn() {
    var selectors = [
      'button[class*="ri-"]',
      'a[class*="ri-"]',
      '[data-ri-buy-now]',
      '[data-ri-buy-button]',
      '[data-releaseit]',
      '[id*="ri-buy"]',
      '[id*="releaseit"]',
      '[class*="releaseit"]',
      '[class*="ri-buy"]'
    ];
    for (var i = 0; i < selectors.length; i++) {
      var el = document.querySelector(selectors[i]);
      if (el && el !== btn) return el;
    }
    return null;
  }

  // Observa el DOM hasta que Releaseit inyecte su botón
  var observer = new MutationObserver(function() {
    var found = findRiBtn();
    if (found) {
      riBtn = found;
      // Oculta el botón inline de Releaseit (usamos el nuestro)
      var parent = riBtn.closest('.shopify-section, section, [class*="ri-section"], [class*="ri-widget"]') || riBtn.parentElement;
      if (parent && parent !== document.getElementById('lp-sticky-bar')) {
        parent.style.display = 'none';
      }
      observer.disconnect();
    }
  });
  observer.observe(document.body, { childList: true, subtree: true });

  // También intenta al cargar
  riBtn = findRiBtn();

  btn.addEventListener('click', function() {
    // Reintenta por si el observer no lo había encontrado aún
    if (!riBtn) riBtn = findRiBtn();

    if (riBtn) {
      riBtn.click();
      return;
    }

    // Intenta API global de Releaseit
    if (window.releaseit && typeof window.releaseit.open === 'function') { window.releaseit.open(); return; }
    if (window.Ri && typeof window.Ri.openForm === 'function') { window.Ri.openForm(); return; }
    if (window.RiBuyNow && typeof window.RiBuyNow.open === 'function') { window.RiBuyNow.open(); return; }

    // Fallback: carrito
    window.location.href = '/cart/{{ cv.id }}:1';
  });
})();
</script>

{% schema %}
{
  "name": "★ Botón Fijo (Ordenar)",
  "settings": [
    { "type": "header", "content": "── BOTÓN ───────────────────────" },
    { "type": "text", "id": "btn_text", "label": "Texto del botón", "default": "Ordenar" },
    { "type": "color", "id": "btn_bg", "label": "Color de fondo del botón", "default": "#1a1a18" },
    { "type": "color", "id": "btn_color", "label": "Color del texto", "default": "#ffffff" },
    { "type": "range", "id": "btn_font_size", "label": "Tamaño de letra (px)", "min": 12, "max": 24, "step": 1, "default": 16 },
    { "type": "range", "id": "btn_py", "label": "Espacio vertical interior (px)", "min": 8, "max": 32, "step": 2, "default": 16 },
    { "type": "range", "id": "btn_px", "label": "Espacio horizontal interior (px)", "min": 16, "max": 80, "step": 4, "default": 48 },
    { "type": "range", "id": "btn_radius", "label": "Bordes redondeados (px)", "min": 0, "max": 50, "step": 2, "default": 6 },
    { "type": "range", "id": "btn_max_width", "label": "Ancho máximo del botón (px)", "min": 200, "max": 800, "step": 20, "default": 480 },
    { "type": "header", "content": "── BARRA ───────────────────────" },
    { "type": "color", "id": "bar_bg", "label": "Color de fondo de la barra", "default": "#ffffff" },
    { "type": "range", "id": "bar_py", "label": "Espacio vertical de la barra (px)", "min": 8, "max": 32, "step": 2, "default": 12 },
    { "type": "range", "id": "bar_px", "label": "Espacio horizontal de la barra (px)", "min": 8, "max": 48, "step": 4, "default": 16 },
    { "type": "range", "id": "bar_height", "label": "Altura reservada en la página (px)", "min": 50, "max": 140, "step": 2, "default": 80 }
  ],
  "presets": [{ "name": "★ Botón Fijo (Ordenar)" }]
}
{% endschema %}
