<section class="showcase" data-showcase-blur style="background: {{ section.settings.bg_color }}">
  <div class="showcase__stack">
    <div class="showcase__sticky-bg">
      {%- if section.settings.image != blank -%}
        <img class="showcase__bg-img" src="{{ section.settings.image | image_url: width: 1600 }}" alt="" width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}" loading="lazy">
      {%- endif -%}
      <div class="showcase__scrim"></div>
    </div>

    <div class="showcase__flow">
      <div class="page-width showcase__intro">
        {%- if section.settings.eyebrow != blank -%}
          <p class="showcase__eyebrow" style="color: {{ section.settings.text_color }}">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="showcase__heading" style="color: {{ section.settings.text_color }}">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="showcase__text rte" style="color: {{ section.settings.text_color }}">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="page-width showcase__grid">
          {%- for block in section.blocks -%}
            <div class="showcase__card" {{ block.shopify_attributes }}>
              <div class="showcase__card-media">
                {%- if block.settings.image != blank -%}
                  <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title | escape }}" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" loading="lazy">
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag }}
                {%- endif -%}
              </div>
              <div class="showcase__card-panel">
                {%- if block.settings.title != blank -%}
                  <h3 class="showcase__card-title">{{ block.settings.title }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <p class="showcase__card-body">{{ block.settings.text }}</p>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Vitrina con fondo",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen de fondo (nítida al llegar, se difumina y queda fija)" },
    { "type": "color", "id": "bg_color", "label": "Color de fondo", "default": "#1B2A3A" },
    { "type": "color", "id": "text_color", "label": "Color del texto", "default": "#FFFFFF" },
    { "type": "text", "id": "eyebrow", "label": "Etiqueta pequeña", "default": "INNOVACIÓN LÍDER" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "Comprobado clínicamente para un envejecimiento celular más saludable." },
    { "type": "richtext", "id": "text", "label": "Texto (opcional)" }
  ],
  "blocks": [
    { "type": "card", "name": "Tarjeta", "settings": [
      { "type": "image_picker", "id": "image", "label": "Imagen" },
      { "type": "text", "id": "title", "label": "Título", "default": "Beneficio" },
      { "type": "textarea", "id": "text", "label": "Descripción" }
    ]}
  ],
  "presets": [{
    "name": "Vitrina con fondo",
    "blocks": [ { "type": "card" }, { "type": "card" }, { "type": "card" } ]
  }]
}
{% endschema %}
