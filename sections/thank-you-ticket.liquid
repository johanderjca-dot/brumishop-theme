<div class="page-width section-pad ty-ticket-wrap">
  <div class="ty-ticket" id="ty-ticket">
    <div class="ty-ticket__top">
      <div class="ty-ticket__emoji">🎉</div>
      <h1 class="ty-ticket__heading">{{ section.settings.heading | default: '¡Gracias por tu compra!' }}</h1>
      <p class="ty-ticket__subheading">{{ section.settings.subheading | default: 'Tu pedido fue confirmado con éxito' }}</p>
    </div>

    <div class="ty-ticket__divider-wrap">
      <div class="ty-ticket__notch ty-ticket__notch--left"></div>
      <div class="ty-ticket__notch ty-ticket__notch--right"></div>
      <div class="ty-ticket__divider"></div>
    </div>

    <p class="ty-ticket__agent-msg">{{ section.settings.agent_message | default: 'Un agente de nuestra tienda te contactará en breve para finalizar tu pedido.' }}</p>
  </div>

  <p class="ty-ticket__note">{{ section.settings.footer_text | default: 'Te enviamos los detalles completos a tu correo.' }}</p>
</div>

{% schema %}
{
  "name": "Ticket de gracias",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "¡Gracias por tu compra!" },
    { "type": "text", "id": "subheading", "label": "Subtítulo", "default": "Tu pedido fue confirmado con éxito" },
    { "type": "textarea", "id": "agent_message", "label": "Mensaje del agente", "default": "Un agente de nuestra tienda te contactará en breve para finalizar tu pedido." },
    { "type": "text", "id": "footer_text", "label": "Texto al pie", "default": "Te enviamos los detalles completos a tu correo." }
  ],
  "presets": [
    { "name": "Ticket de gracias" }
  ]
}
{% endschema %}
