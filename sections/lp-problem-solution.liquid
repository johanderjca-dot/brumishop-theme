{% assign cv = product.selected_or_first_available_variant %}

<style>
  .lp-ps-btn {
    display: inline-block;
    transition: transform 160ms cubic-bezier(0.23,1,0.32,1), opacity .15s;
  }
  .lp-ps-btn:hover { opacity: .88; }
  .lp-ps-btn:active { transform: scale(0.97); }
  .lp-ps-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    align-items: center;
  }
  @media (max-width: 767px) {
    .lp-ps-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    .lp-ps-img-first { order: -1; }
    .lp-ps-text-first { order: 1; }
  }
</style>

{% for block in section.blocks %}
  {% assign is_even = forloop.index0 | modulo: 2 %}

  <section {{ block.shopify_attributes }}
           style="background:{% if is_even == 0 %}{{ section.settings.bg_odd }}{% else %}{{ section.settings.bg_even }}{% endif %}; padding:{{ section.settings.py }}px 0; border-top:1px solid {{ section.settings.border_color }};">
    <div class="lp-ps-grid" style="max-width:1320px; margin:0 auto; padding:0 1.5rem;">

      {% if is_even == 0 %}
        <div class="lp-ps-text-first">{% render 'lp-ps-text', block: block, section: section, cv: cv %}</div>
        <div class="lp-ps-img-first">{% render 'lp-ps-image', block: block, section: section %}</div>
      {% else %}
        <div class="lp-ps-img-first">{% render 'lp-ps-image', block: block, section: section %}</div>
        <div class="lp-ps-text-first">{% render 'lp-ps-text', block: block, section: section, cv: cv %}</div>
      {% endif %}

    </div>
  </section>
{% endfor %}

{% schema %}
{
  "name": "Problema / Solución",
  "settings": [
    { "type": "range", "id": "py", "label": "Espacio vertical por bloque (px)", "min": 24, "max": 120, "step": 4, "default": 40 },
    { "type": "color", "id": "bg_odd", "label": "Fondo secciones impares (1°, 3°)", "default": "#FFFFFF" },
    { "type": "color", "id": "bg_even", "label": "Fondo secciones pares (2°)", "default": "#FAFAF6" },
    { "type": "color", "id": "border_color", "label": "Color separador", "default": "#E8E8E2" },
    { "type": "color", "id": "problem_color", "label": "Color etiqueta problema", "default": "#c0392b" },
    { "type": "color", "id": "solution_color", "label": "Color etiqueta solución", "default": "#5a7a40" },
    { "type": "color", "id": "heading_color", "label": "Color títulos", "default": "#1a1a18" },
    { "type": "color", "id": "text_color", "label": "Color texto", "default": "#5a5a52" },
    { "type": "color", "id": "img_bg", "label": "Fondo imagen", "default": "#F0F0EA" }
  ],
  "max_blocks": 3,
  "blocks": [
    {
      "type": "block",
      "name": "Bloque Prob/Solución",
      "settings": [
        { "type": "header", "content": "Problema" },
        { "type": "text", "id": "problem_label", "label": "Etiqueta (ej: EL PROBLEMA)", "default": "EL PROBLEMA" },
        { "type": "text", "id": "problem_title", "label": "Título del problema", "default": "¿Cansado de productos que no funcionan?" },
        { "type": "textarea", "id": "problem_text", "label": "Descripción del problema", "default": "Muchos productos en el mercado prometen resultados pero no los cumplen. Pierdes dinero y tiempo sin ver mejoras reales." },
        { "type": "header", "content": "Solución" },
        { "type": "text", "id": "solution_label", "label": "Etiqueta (ej: LA SOLUCIÓN)", "default": "LA SOLUCIÓN" },
        { "type": "text", "id": "solution_title", "label": "Título de la solución", "default": "Nuestro producto sí funciona — garantizado" },
        { "type": "textarea", "id": "solution_text", "label": "Descripción de la solución", "default": "Con nuestra fórmula probada y miles de clientes satisfechos, verás resultados reales desde la primera semana de uso." },
        { "type": "header", "content": "Botón de compra" },
        { "type": "checkbox", "id": "show_btn", "label": "Mostrar botón de compra", "default": true },
        { "type": "text", "id": "btn_text", "label": "Texto del botón", "default": "Quiero este producto" },
        { "type": "color", "id": "btn_bg", "label": "Fondo botón", "default": "#1a1a18" },
        { "type": "color", "id": "btn_color", "label": "Color texto botón", "default": "#FFFFFF" },
        { "type": "range", "id": "btn_radius", "label": "Bordes redondeados botón (px)", "min": 0, "max": 50, "step": 2, "default": 4 },
        { "type": "header", "content": "Imagen" },
        { "type": "image_picker", "id": "image", "label": "Imagen del bloque" },
        { "type": "range", "id": "img_radius", "label": "Bordes redondeados imagen (px)", "min": 0, "max": 24, "step": 2, "default": 8 },
        { "type": "range", "id": "img_height", "label": "Altura máxima imagen (px)", "min": 200, "max": 700, "step": 20, "default": 440 }
      ]
    }
  ],
  "presets": [{
    "name": "Problema / Solución",
    "blocks": [
      { "type": "block" },
      { "type": "block", "settings": { "problem_label": "EL RETO", "problem_title": "Opciones caras que no duran", "solution_label": "NUESTRA VENTAJA", "solution_title": "Máxima calidad al mejor precio" } },
      { "type": "block", "settings": { "problem_label": "¿TE HA PASADO?", "problem_title": "Compras algo y llega diferente a la foto", "solution_label": "CON NOSOTROS", "solution_title": "Lo que ves es lo que recibes, siempre" } }
    ]
  }]
}
{% endschema %}
