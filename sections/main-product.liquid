{{ 'section-product.css' | asset_url | stylesheet_tag }}

<section class="product page-width" data-product-section>
  <div class="product__grid">

    <div class="product__media" style="{% if section.settings.bg_color != blank %}--product-media-bg: {{ section.settings.bg_color }};{% endif %}">
      {%- if product.media.size > 0 -%}
        <div class="product__gallery" data-gallery>
          <div class="product__main-media">
            {%- if section.settings.badge_text != blank -%}
              <span class="product__media-badge">
                {{ section.settings.badge_text }}
                <span class="product__media-badge-stars">★★★★★</span>
                {%- if section.settings.badge_rating != blank -%}<span class="product__media-badge-rating">{{ section.settings.badge_rating }}</span>{%- endif -%}
              </span>
            {%- endif -%}
            {%- for media in product.media limit: 1 -%}
              {%- if media.media_type == 'image' -%}
                <img id="ProductMainImage"
                  src="{{ media | image_url: width: 1200 }}"
                  srcset="{{ media | image_url: width: 600 }} 600w, {{ media | image_url: width: 1200 }} 1200w, {{ media | image_url: width: 1600 }} 1600w"
                  sizes="(min-width: 990px) 50vw, 100vw"
                  alt="{{ media.alt | escape }}"
                  width="{{ media.width }}" height="{{ media.height }}"
                  fetchpriority="high">
              {%- else -%}
                {{ media | media_tag }}
              {%- endif -%}
            {%- endfor -%}
            {%- if product.media.size > 1 -%}
              <button type="button" class="product__media-nav product__media-nav--prev" data-gallery-prev aria-label="Imagen anterior">{% render 'icon-caret' %}</button>
              <button type="button" class="product__media-nav product__media-nav--next" data-gallery-next aria-label="Siguiente imagen">{% render 'icon-caret' %}</button>
            {%- endif -%}
          </div>

          {%- if product.media.size > 1 -%}
            <div class="product__thumbs">
              {%- for media in product.media -%}
                {%- if media.media_type == 'image' -%}
                  <button class="product__thumb" type="button"
                    data-thumb="{{ media | image_url: width: 1200 }}"
                    aria-label="Imagen {{ forloop.index }}">
                    <img src="{{ media | image_url: width: 200 }}" alt="" width="100" height="100" loading="lazy">
                  </button>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'product__placeholder' }}
      {%- endif -%}
    </div>

    <div class="product__info">
      {%- for block in section.blocks -%}
        {%- case block.type -%}

          {%- when '@app' -%}
            <div class="product__block product__block--app" {{ block.shopify_attributes }}>
              {% render block %}
            </div>

          {%- when 'eyebrow' -%}
            {%- if block.settings.text != blank -%}
              <p class="product__eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
            {%- endif -%}

          {%- when 'title' -%}
            <h1 class="product__title" {{ block.shopify_attributes }}>{{ product.title }}</h1>

          {%- when 'rating' -%}
            <div class="product__rating" {{ block.shopify_attributes }}>
              <span class="product__stars">★★★★★</span>
              {%- if block.settings.text != blank -%}<span>{{ block.settings.text }}</span>{%- endif -%}
            </div>

          {%- when 'chips' -%}
            {%- if block.settings.items != blank -%}
              <ul class="product__chips" {{ block.shopify_attributes }}>
                {%- assign chips = block.settings.items | split: ',' -%}
                {%- for chip in chips -%}
                  <li>{{ chip | strip }}</li>
                {%- endfor -%}
              </ul>
            {%- endif -%}

          {%- when 'price' -%}
            <div class="product__price" {{ block.shopify_attributes }}>
              {%- if product.compare_at_price > product.price -%}
                <s class="product__price-was">{{ product.compare_at_price | money }}</s>
              {%- endif -%}
              <span class="product__price-now">{{ product.price | money }}</span>
              {%- if product.compare_at_price > product.price -%}
                {%- assign pct = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
                <span class="product__badge">-{{ pct }}%</span>
              {%- endif -%}
            </div>

          {%- when 'description' -%}
            <div class="product__description rte" {{ block.shopify_attributes }}>{{ product.description }}</div>

          {%- when 'text' -%}
            <div class="product__text rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

          {%- when 'trust' -%}
            <ul class="product__trust" {{ block.shopify_attributes }}>
              {%- if block.settings.item1 != blank -%}<li>{{ block.settings.item1 }}</li>{%- endif -%}
              {%- if block.settings.item2 != blank -%}<li>{{ block.settings.item2 }}</li>{%- endif -%}
              {%- if block.settings.item3 != blank -%}<li>{{ block.settings.item3 }}</li>{%- endif -%}
            </ul>

          {%- when 'buy_buttons' -%}
            <div class="product__buy" {{ block.shopify_attributes }}>
              {%- form 'product', product, id: 'ProductForm', class: 'product__form' -%}
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                {%- unless product.has_only_default_variant -%}
                  <div class="product__variants">
                    {%- for option in product.options_with_values -%}
                      <div class="product__option">
                        <span class="product__option-label">{{ option.name }}</span>
                        <div class="product__option-pills" role="radiogroup">
                          {%- for value in option.values -%}
                            <label class="product__pill{% if option.selected_value == value %} is-active{% endif %}">
                              <input type="radio" name="options[{{ option.name | escape }}]" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %} data-option-selector>
                              <span>{{ value }}</span>
                            </label>
                          {%- endfor -%}
                        </div>
                      </div>
                    {%- endfor -%}
                  </div>
                {%- endunless -%}
                <button type="submit" class="btn btn--primary btn--full" {% unless product.available %}disabled{% endunless %}>
                  {%- if product.available -%}{{ block.settings.label | default: 'Agregar al carrito' }}{%- else -%}Agotado{%- endif -%}
                </button>
                {%- if block.settings.sublabel != blank -%}
                  <span class="product__buy-sub">{{ block.settings.sublabel }}</span>
                {%- endif -%}
              {%- endform -%}
            </div>

          {%- when 'purchase_card' -%}
            <div class="product__purchase-card" {{ block.shopify_attributes }}>
              {%- if block.settings.header_label != blank -%}
                <div class="product__purchase-card-header">{{ block.settings.header_label }}</div>
              {%- endif -%}
              <div class="product__purchase-card-body">
                <div class="product__price product__price--card">
                  {%- if product.compare_at_price > product.price -%}
                    <s class="product__price-was">{{ product.compare_at_price | money }}</s>
                  {%- endif -%}
                  <span class="product__price-now">{{ product.price | money }}</span>
                  {%- if product.compare_at_price > product.price -%}
                    {%- assign pct = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
                    <span class="product__badge">-{{ pct }}%</span>
                  {%- endif -%}
                </div>
                {%- if block.settings.item1 != blank or block.settings.item2 != blank or block.settings.item3 != blank -%}
                  <ul class="product__trust">
                    {%- if block.settings.item1 != blank -%}<li>{{ block.settings.item1 }}</li>{%- endif -%}
                    {%- if block.settings.item2 != blank -%}<li>{{ block.settings.item2 }}</li>{%- endif -%}
                    {%- if block.settings.item3 != blank -%}<li>{{ block.settings.item3 }}</li>{%- endif -%}
                  </ul>
                {%- endif -%}
                {%- form 'product', product, class: 'product__form' -%}
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                  {%- unless product.has_only_default_variant -%}
                    <div class="product__variants">
                      {%- for option in product.options_with_values -%}
                        <div class="product__option">
                          <span class="product__option-label">{{ option.name }}</span>
                          <div class="product__option-pills" role="radiogroup">
                            {%- for value in option.values -%}
                              <label class="product__pill{% if option.selected_value == value %} is-active{% endif %}">
                                <input type="radio" name="options[{{ option.name | escape }}]" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %} data-option-selector>
                                <span>{{ value }}</span>
                              </label>
                            {%- endfor -%}
                          </div>
                        </div>
                      {%- endfor -%}
                    </div>
                  {%- endunless -%}
                  <button type="submit" class="btn btn--primary btn--full" {% unless product.available %}disabled{% endunless %}>
                    {%- if product.available -%}{{ block.settings.button_label | default: 'Comprar ahora, pagar en casa' }}{%- else -%}Agotado{%- endif -%}
                  </button>
                {%- endform -%}
              </div>
            </div>

          {%- when 'collapsible' -%}
            <details class="product__collapsible" {{ block.shopify_attributes }}>
              <summary>{{ block.settings.heading | default: 'Más información' }}</summary>
              <div class="rte">{{ block.settings.content }}</div>
            </details>

          {%- when 'divider' -%}
            <hr class="product__divider" {{ block.shopify_attributes }}>

        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{%- if section.settings.sticky_bar -%}
  <div class="sticky-buy" data-sticky-buy hidden>
    <div class="sticky-buy__inner page-width">
      <div class="sticky-buy__product">
        {%- if product.featured_image -%}
          <img src="{{ product.featured_image | image_url: width: 120 }}" alt="" width="48" height="48" loading="lazy">
        {%- endif -%}
        <div>
          <span class="sticky-buy__title">{{ product.title }}</span>
          <span class="sticky-buy__price">{{ product.price | money }}</span>
        </div>
      </div>
      <button class="btn btn--primary" type="button" data-sticky-cta>
        {{ section.settings.sticky_label | default: 'Ordenar ahora' }}
      </button>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Producto",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Galería" },
    { "type": "color", "id": "bg_color", "label": "Color de fondo de la galería (opcional)" },
    { "type": "text", "id": "badge_text", "label": "Texto de la insignia sobre la imagen (opcional)" },
    { "type": "text", "id": "badge_rating", "label": "Calificación junto a las estrellas (opcional)", "default": "4.9/5.0" },

    { "type": "header", "content": "Barra fija de compra" },
    { "type": "checkbox", "id": "sticky_bar", "label": "Mostrar barra fija al bajar", "default": true, "info": "Aparece abajo con el producto, el precio y el botón. Sube mucho la conversión en móvil." },
    { "type": "text", "id": "sticky_label", "label": "Texto del botón fijo", "default": "Ordenar ahora" }
  ],
  "blocks": [
    { "type": "@app" },
    { "type": "eyebrow", "name": "Etiqueta pequeña", "limit": 2, "settings": [ { "type": "text", "id": "text", "label": "Texto", "default": "FÓRMULA COREANA" } ] },
    { "type": "title", "name": "Título del producto", "limit": 1 },
    { "type": "rating", "name": "Estrellas", "limit": 1, "settings": [ { "type": "text", "id": "text", "label": "Texto al lado", "default": "Valoración 4.9/5" } ] },
    { "type": "chips", "name": "Chips de ingredientes", "limit": 2, "settings": [ { "type": "text", "id": "items", "label": "Separados por coma", "default": "Retinol, Centella, TECA, Coreano" } ] },
    { "type": "price", "name": "Precio", "limit": 1 },
    { "type": "description", "name": "Descripción del producto", "limit": 1 },
    { "type": "text", "name": "Texto libre", "settings": [ { "type": "richtext", "id": "text", "label": "Texto" } ] },
    {
      "type": "trust", "name": "Línea de confianza", "limit": 2,
      "settings": [
        { "type": "text", "id": "item1", "label": "Punto 1", "default": "Paga al recibir" },
        { "type": "text", "id": "item2", "label": "Punto 2", "default": "Envío gratis" },
        { "type": "text", "id": "item3", "label": "Punto 3", "default": "Entrega 24-48h" }
      ]
    },
    {
      "type": "buy_buttons", "name": "Botón de compra", "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Texto del botón", "default": "Agregar al carrito" },
        { "type": "text", "id": "sublabel", "label": "Texto debajo", "default": "Pagas cuando lo recibes" }
      ]
    },
    {
      "type": "purchase_card", "name": "Caja de compra (tarjeta)", "limit": 1,
      "settings": [
        { "type": "text", "id": "header_label", "label": "Encabezado de la tarjeta", "default": "MEJOR VALOR" },
        { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Comprar ahora, pagar en casa" },
        { "type": "text", "id": "item1", "label": "Punto 1", "default": "Paga cuando lo recibes" },
        { "type": "text", "id": "item2", "label": "Punto 2", "default": "Envío gratis a todo el país" },
        { "type": "text", "id": "item3", "label": "Punto 3", "default": "Cambios sin complicaciones" }
      ]
    },
    {
      "type": "collapsible", "name": "Acordeón",
      "settings": [
        { "type": "text", "id": "heading", "label": "Título", "default": "Cómo usarlo" },
        { "type": "richtext", "id": "content", "label": "Contenido" }
      ]
    },
    { "type": "divider", "name": "Separador" }
  ],
  "default": {
    "blocks": [
      { "type": "rating" },
      { "type": "title" },
      { "type": "chips" },
      { "type": "description" },
      { "type": "purchase_card" }
    ]
  }
}
{% endschema %}
