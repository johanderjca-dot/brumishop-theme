{% assign show = true %}
{% if section.settings.image == blank and section.settings.require_image %}{% assign show = false %}{% endif %}

{% if show %}
<section style="background:{{ section.settings.bg_color }}; padding:{{ section.settings.py }}px 0;">

  {% if section.settings.layout == 'fullwidth' %}
    <!-- Full-width image with optional overlay text -->
    <div style="position:relative;">
      {% if section.settings.image != blank %}
        <img src="{{ section.settings.image | image_url: width: 2000 }}"
             alt="{{ section.settings.title | escape }}"
             style="width:100%; max-height:{{ section.settings.img_height }}px; object-fit:{{ section.settings.img_fit }}; display:block;">
      {% else %}
        <div style="background:#E8E8E2; height:{{ section.settings.img_height }}px; display:flex; align-items:center; justify-content:center;">
          <p style="color:#a0a09a;">Sube una imagen de cómo se usa el producto</p>
        </div>
      {% endif %}
      {% if section.settings.title != blank or section.settings.description != blank %}
        <div style="position:absolute; inset:0; background:rgba(0,0,0,{{ section.settings.overlay_opacity | divided_by: 100.0 }}); display:flex; align-items:center; justify-content:{{ section.settings.text_x }};">
          <div style="text-align:{{ section.settings.text_align }}; padding:2rem; max-width:640px;">
            {% if section.settings.title != blank %}
              <h2 style="font-family:'Cormorant Garamond',Georgia,serif; font-size:clamp(1.75rem,4vw,3.5rem); font-weight:600; color:#fff; margin-bottom:0.75rem; line-height:1.15;">
                {{ section.settings.title }}
              </h2>
            {% endif %}
            {% if section.settings.description != blank %}
              <p style="font-size:1rem; color:rgba(255,255,255,0.82); line-height:1.7;">{{ section.settings.description }}</p>
            {% endif %}
          </div>
        </div>
      {% endif %}
    </div>

  {% else %}
    <!-- Split layout (image + text side by side) -->
    <div style="max-width:1320px; margin:0 auto; padding:0 1.5rem; display:grid; grid-template-columns:{% if section.settings.layout == 'image-left' %}{{ section.settings.img_col }}fr {{ section.settings.text_col }}fr{% else %}{{ section.settings.text_col }}fr {{ section.settings.img_col }}fr{% endif %}; gap:3rem; align-items:center;">

      {% if section.settings.layout == 'image-left' %}
        <!-- Image -->
        <div>
          {% if section.settings.image != blank %}
            <img src="{{ section.settings.image | image_url: width: 1200 }}"
                 alt="{{ section.settings.title | escape }}"
                 style="width:100%; border-radius:{{ section.settings.img_radius }}px; object-fit:{{ section.settings.img_fit }}; max-height:{{ section.settings.img_height }}px;">
          {% else %}
            <div style="background:#E8E8E2; height:400px; border-radius:{{ section.settings.img_radius }}px; display:flex; align-items:center; justify-content:center;">
              <p style="color:#a0a09a; font-size:0.875rem;">Sube la imagen en el editor</p>
            </div>
          {% endif %}
        </div>
        <!-- Text -->
        <div>{% render 'lp-how-to-use-text', section: section %}</div>
      {% else %}
        <!-- Text -->
        <div>{% render 'lp-how-to-use-text', section: section %}</div>
        <!-- Image -->
        <div>
          {% if section.settings.image != blank %}
            <img src="{{ section.settings.image | image_url: width: 1200 }}"
                 alt="{{ section.settings.title | escape }}"
                 style="width:100%; border-radius:{{ section.settings.img_radius }}px; object-fit:{{ section.settings.img_fit }}; max-height:{{ section.settings.img_height }}px;">
          {% else %}
            <div style="background:#E8E8E2; height:400px; border-radius:{{ section.settings.img_radius }}px; display:flex; align-items:center; justify-content:center;">
              <p style="color:#a0a09a; font-size:0.875rem;">Sube la imagen en el editor</p>
            </div>
          {% endif %}
        </div>
      {% endif %}

    </div>
  {% endif %}

</section>
{% endif %}

{% schema %}
{
  "name": "9 — Cómo Usarlo",
  "settings": [
    { "type": "header", "content": "Imagen" },
    { "type": "image_picker", "id": "image", "label": "Imagen de cómo usar el producto" },
    { "type": "range", "id": "img_height", "label": "Altura máxima de la imagen (px)", "min": 200, "max": 900, "step": 20, "default": 500 },
    { "type": "select", "id": "img_fit", "label": "Ajuste de imagen", "options": [{"value":"cover","label":"Recortar (llenar)"},{"value":"contain","label":"Completa"}], "default": "cover" },
    { "type": "range", "id": "img_radius", "label": "Bordes redondeados imagen (px, solo layouts con texto)", "min": 0, "max": 24, "step": 2, "default": 4 },
    { "type": "header", "content": "Textos" },
    { "type": "text", "id": "eyebrow", "label": "Etiqueta (texto pequeño arriba)", "default": "MODO DE USO" },
    { "type": "text", "id": "title", "label": "Título", "default": "¿Cómo se usa?" },
    { "type": "richtext", "id": "description", "label": "Descripción" },
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "layout", "label": "Diseño", "options": [{"value":"image-left","label":"Imagen a la izquierda"},{"value":"image-right","label":"Imagen a la derecha"},{"value":"fullwidth","label":"Imagen ancho completo (texto encima)"}], "default": "image-right" },
    { "type": "range", "id": "img_col", "label": "Proporción imagen (solo layouts laterales)", "min": 1, "max": 3, "step": 1, "default": 1, "info": "1=mismo espacio, 2=imagen 2× más grande que texto" },
    { "type": "range", "id": "text_col", "label": "Proporción texto", "min": 1, "max": 3, "step": 1, "default": 1 },
    { "type": "header", "content": "Si usas imagen de fondo completa" },
    { "type": "range", "id": "overlay_opacity", "label": "Oscuridad del fondo (0=transparente, 70=oscuro)", "min": 0, "max": 80, "step": 5, "default": 40 },
    { "type": "select", "id": "text_x", "label": "Posición horizontal del texto", "options": [{"value":"flex-start","label":"Izquierda"},{"value":"center","label":"Centro"},{"value":"flex-end","label":"Derecha"}], "default": "center" },
    { "type": "select", "id": "text_align", "label": "Alineación del texto", "options": [{"value":"left","label":"Izquierda"},{"value":"center","label":"Centro"}], "default": "center" },
    { "type": "header", "content": "Sección" },
    { "type": "color", "id": "bg_color", "label": "Fondo", "default": "#F8F7F3" },
    { "type": "color", "id": "eyebrow_color", "label": "Color etiqueta", "default": "#5a7a40" },
    { "type": "color", "id": "heading_color", "label": "Color título", "default": "#1a1a18" },
    { "type": "color", "id": "text_color", "label": "Color descripción", "default": "#5a5a52" },
    { "type": "range", "id": "py", "label": "Espacio vertical (px)", "min": 0, "max": 120, "step": 8, "default": 72 }
  ],
  "presets": [{ "name": "9 — Cómo Usarlo" }]
}
{% endschema %}
