{% if section.blocks.size > 0 %}
<style>
  .htu-wrap {
    background: {{ section.settings.bg_color }};
    padding: {{ section.settings.pt }}px {{ section.settings.px }}px {{ section.settings.pb }}px;
  }
  .htu-title {
    font-size: {{ section.settings.title_size }}px;
    font-weight: 700;
    color: {{ section.settings.title_color }};
    text-align: {{ section.settings.title_align }};
    margin: 0 0 {{ section.settings.title_gap }}px;
  }
  .htu-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.cols_mobile }}, 1fr);
    gap: {{ section.settings.gap }}px;
  }
  @media (min-width: 640px) {
    .htu-grid {
      grid-template-columns: repeat({{ section.settings.cols_desktop }}, 1fr);
    }
  }
  .htu-item {
    position: relative;
    border-radius: {{ section.settings.radius }}px;
    overflow: hidden;
    line-height: 0;
  }
  .htu-item img {
    width: 100%;
    height: {{ section.settings.photo_height }}px;
    object-fit: cover;
    display: block;
  }
  .htu-step {
    position: absolute;
    top: 8px;
    left: 8px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: {{ section.settings.step_bg }};
    color: {{ section.settings.step_color }};
    font-size: 12px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }
</style>

<section class="htu-wrap">
  {% if section.settings.title != blank %}
    <p class="htu-title">{{ section.settings.title }}</p>
  {% endif %}

  <div class="htu-grid">
    {% for block in section.blocks %}
      {% if block.settings.photo != blank %}
        <div class="htu-item" {{ block.shopify_attributes }}>
          <img src="{{ block.settings.photo | image_url: width: 600 }}"
               alt="{{ block.settings.alt | default: 'Paso ' | append: forloop.index | escape }}"
               loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
          {% if section.settings.show_steps %}
            <div class="htu-step">{{ forloop.index }}</div>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>
{% endif %}

{% schema %}
{
  "name": "Cómo Usarla",
  "settings": [
    { "type": "text", "id": "title", "label": "Título (opcional)", "default": "¿Cómo se usa?" },
    { "type": "range", "id": "title_size", "label": "Tamaño título (px)", "min": 14, "max": 36, "step": 1, "default": 20 },
    { "type": "color", "id": "title_color", "label": "Color título", "default": "#1a1a18" },
    { "type": "select", "id": "title_align", "label": "Alineación título", "options": [{"value":"left","label":"Izquierda"},{"value":"center","label":"Centro"}], "default": "left" },
    { "type": "range", "id": "title_gap", "label": "Espacio título-fotos (px)", "min": 4, "max": 32, "step": 2, "default": 12 },

    { "type": "header", "content": "Fotos" },
    { "type": "range", "id": "cols_mobile", "label": "Columnas en móvil", "min": 1, "max": 3, "step": 1, "default": 2 },
    { "type": "range", "id": "cols_desktop", "label": "Columnas en desktop", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "range", "id": "photo_height", "label": "Alto de foto (px)", "min": 80, "max": 400, "step": 10, "default": 160 },
    { "type": "range", "id": "radius", "label": "Bordes redondeados (px)", "min": 0, "max": 24, "step": 2, "default": 8 },
    { "type": "range", "id": "gap", "label": "Espacio entre fotos (px)", "min": 4, "max": 24, "step": 2, "default": 8 },

    { "type": "header", "content": "Número de paso" },
    { "type": "checkbox", "id": "show_steps", "label": "Mostrar número de paso", "default": false },
    { "type": "color", "id": "step_bg", "label": "Fondo del número", "default": "#1a1a18" },
    { "type": "color", "id": "step_color", "label": "Color del número", "default": "#ffffff" },

    { "type": "header", "content": "Espaciado y fondo" },
    { "type": "color", "id": "bg_color", "label": "Fondo sección", "default": "#ffffff" },
    { "type": "range", "id": "pt", "label": "Espacio superior (px)", "min": 0, "max": 48, "step": 4, "default": 16 },
    { "type": "range", "id": "pb", "label": "Espacio inferior (px)", "min": 0, "max": 48, "step": 4, "default": 16 },
    { "type": "range", "id": "px", "label": "Margen lateral (px)", "min": 0, "max": 32, "step": 2, "default": 16 }
  ],
  "max_blocks": 12,
  "blocks": [
    {
      "type": "step",
      "name": "Foto",
      "settings": [
        { "type": "image_picker", "id": "photo", "label": "Foto del paso" },
        { "type": "text", "id": "alt", "label": "Texto alternativo (opcional)" }
      ]
    }
  ],
  "presets": [{ "name": "Cómo Usarla" }]
}
{% endschema %}
