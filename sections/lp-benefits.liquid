<section style="background:{{ section.settings.bg_color }}; padding:{{ section.settings.pt }}px 0 {{ section.settings.pb }}px;">
  <div style="max-width:1320px; margin:0 auto; padding:0 1rem;">

    {% if section.blocks.size > 0 %}
      <div style="display:grid; grid-template-columns:repeat({{ section.settings.columns }},1fr); gap:{{ section.settings.gap }}px;">
        {% for block in section.blocks %}
          <div {{ block.shopify_attributes }}
               style="display:flex; align-items:flex-start; gap:{{ section.settings.icon_gap }}px;
                      {% if block.settings.show_box %}
                        background:{{ block.settings.box_bg }};
                        border:1px solid {{ section.settings.box_border_color }};
                        border-radius:{{ section.settings.box_radius }}px;
                        padding:{{ section.settings.box_pad }}px;
                      {% endif %}">

            {% if block.settings.icon_img != blank %}
              <img src="{{ block.settings.icon_img | image_url: width: 120 }}"
                   alt=""
                   style="width:{{ section.settings.icon_size }}px; height:{{ section.settings.icon_size }}px; object-fit:contain; flex-shrink:0;">
            {% elsif block.settings.icon_emoji != blank %}
              <span style="font-size:{{ section.settings.icon_size }}px; line-height:1; flex-shrink:0;">{{ block.settings.icon_emoji }}</span>
            {% endif %}

            <div>
              {% if block.settings.title != blank %}
                <p style="font-size:{{ section.settings.item_title_size }}px; font-weight:600; color:{{ section.settings.heading_color }}; margin:0 0 2px; line-height:1.3;">
                  {{ block.settings.title }}
                </p>
              {% endif %}
              {% if block.settings.description != blank %}
                <p style="font-size:{{ section.settings.item_desc_size }}px; color:{{ section.settings.text_color }}; line-height:1.5; margin:0;">
                  {{ block.settings.description }}
                </p>
              {% endif %}
            </div>

          </div>
        {% endfor %}
      </div>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "3 — Beneficios",
  "settings": [
    { "type": "header", "content": "Cuadrícula" },
    { "type": "select", "id": "columns", "label": "Columnas", "options": [{"value":"1","label":"1"},{"value":"2","label":"2"},{"value":"3","label":"3"}], "default": "1" },
    { "type": "range", "id": "gap", "label": "Espacio entre ítems (px)", "min": 4, "max": 40, "step": 2, "default": 10 },

    { "type": "header", "content": "Ícono" },
    { "type": "range", "id": "icon_size", "label": "Tamaño del ícono (px)", "min": 16, "max": 64, "step": 4, "default": 28 },
    { "type": "range", "id": "icon_gap", "label": "Espacio ícono → texto (px)", "min": 4, "max": 32, "step": 2, "default": 10 },

    { "type": "header", "content": "Texto" },
    { "type": "range", "id": "item_title_size", "label": "Tamaño título ítem (px)", "min": 12, "max": 24, "step": 1, "default": 15 },
    { "type": "range", "id": "item_desc_size", "label": "Tamaño descripción ítem (px)", "min": 11, "max": 18, "step": 1, "default": 13 },

    { "type": "header", "content": "Cuadro (opcional)" },
    { "type": "color", "id": "box_border_color", "label": "Color del borde", "default": "#E8E8E2" },
    { "type": "range", "id": "box_radius", "label": "Bordes redondeados (px)", "min": 0, "max": 24, "step": 2, "default": 8 },
    { "type": "range", "id": "box_pad", "label": "Padding del cuadro (px)", "min": 8, "max": 40, "step": 4, "default": 16 },

    { "type": "header", "content": "Espaciado y colores" },
    { "type": "range", "id": "pt", "label": "Espacio superior (px)", "min": 0, "max": 64, "step": 4, "default": 12 },
    { "type": "range", "id": "pb", "label": "Espacio inferior (px)", "min": 0, "max": 64, "step": 4, "default": 12 },
    { "type": "color", "id": "bg_color", "label": "Fondo sección", "default": "#FAFAF6" },
    { "type": "color", "id": "heading_color", "label": "Color títulos", "default": "#1a1a18" },
    { "type": "color", "id": "text_color", "label": "Color texto", "default": "#5a5a52" }
  ],
  "max_blocks": 12,
  "blocks": [
    {
      "type": "benefit",
      "name": "Beneficio",
      "settings": [
        { "type": "image_picker", "id": "icon_img", "label": "Imagen del ícono" },
        { "type": "text", "id": "icon_emoji", "label": "Emoji (si no subes imagen)", "default": "✓" },
        { "type": "text", "id": "title", "label": "Título", "default": "Beneficio" },
        { "type": "textarea", "id": "description", "label": "Descripción (opcional)" },
        { "type": "checkbox", "id": "show_box", "label": "Mostrar cuadro en este ítem", "default": false },
        { "type": "color", "id": "box_bg", "label": "Fondo del cuadro", "default": "#FFFFFF" }
      ]
    }
  ],
  "presets": [{
    "name": "3 — Beneficios",
    "blocks": [
      { "type": "benefit", "settings": { "icon_emoji": "✓", "title": "Alta calidad" } },
      { "type": "benefit", "settings": { "icon_emoji": "⚡", "title": "Resultados rápidos" } },
      { "type": "benefit", "settings": { "icon_emoji": "🚚", "title": "Envío gratis a todo RD" } }
    ]
  }]
}
{% endschema %}
