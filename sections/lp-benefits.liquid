<section style="background:{{ section.settings.bg_color }}; padding:{{ section.settings.py }}px 0;">
  <div style="max-width:1320px; margin:0 auto; padding:0 1.5rem;">

    {% if section.settings.title != blank %}
      <h2 style="font-family:'Cormorant Garamond',Georgia,serif; font-size:clamp(1.75rem,3vw,2.75rem); font-weight:600; color:{{ section.settings.heading_color }}; text-align:{{ section.settings.title_align }}; margin-bottom:{% if section.settings.subtitle != blank %}0.75rem{% else %}2rem{% endif %};">
        {{ section.settings.title }}
      </h2>
    {% endif %}

    {% if section.settings.subtitle != blank %}
      <p style="font-size:1rem; color:{{ section.settings.text_color }}; text-align:{{ section.settings.title_align }}; margin-bottom:2rem; max-width:60ch; {% if section.settings.title_align == 'center' %}margin-left:auto;margin-right:auto;{% endif %}">
        {{ section.settings.subtitle }}
      </p>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div style="display:grid; grid-template-columns:repeat({{ section.settings.columns }},1fr); gap:{{ section.settings.gap }}px;">
        {% for block in section.blocks %}
          <div {{ block.shopify_attributes }}
               style="display:flex; align-items:flex-start; gap:{{ section.settings.icon_gap }}px;
                      {% if block.settings.show_box %}
                        background:{{ block.settings.box_bg }};
                        border:{{ section.settings.box_border_width }}px solid {{ block.settings.box_border_color }};
                        border-radius:{{ section.settings.box_radius }}px;
                        padding:{{ section.settings.box_pad }}px;
                      {% endif %}">

            {% comment %} Ícono: imagen externa o emoji/texto {% endcomment %}
            {% if block.settings.icon_url != blank %}
              <img src="{{ block.settings.icon_url }}"
                   alt=""
                   width="{{ section.settings.icon_size }}"
                   height="{{ section.settings.icon_size }}"
                   style="width:{{ section.settings.icon_size }}px; height:{{ section.settings.icon_size }}px; object-fit:contain; flex-shrink:0; margin-top:2px;">
            {% elsif block.settings.icon_emoji != blank %}
              <span style="font-size:{{ section.settings.icon_size }}px; line-height:1; flex-shrink:0; margin-top:2px;">{{ block.settings.icon_emoji }}</span>
            {% endif %}

            <div>
              {% if block.settings.title != blank %}
                <p style="font-size:{{ section.settings.item_title_size }}px; font-weight:600; color:{{ section.settings.heading_color }}; margin-bottom:0.3rem; line-height:1.3;">
                  {{ block.settings.title }}
                </p>
              {% endif %}
              {% if block.settings.description != blank %}
                <p style="font-size:{{ section.settings.item_desc_size }}px; color:{{ section.settings.text_color }}; line-height:1.65;">
                  {{ block.settings.description }}
                </p>
              {% endif %}
            </div>

          </div>
        {% endfor %}
      </div>
    {% else %}
      <p style="text-align:center; color:#a0a09a; font-size:0.875rem; padding:2rem 0;">
        Agrega beneficios con el botón "Agregar beneficio" en el panel izquierdo del editor.
      </p>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "3 — Beneficios",
  "settings": [
    { "type": "header", "content": "Encabezado" },
    { "type": "text", "id": "title", "label": "Título de la sección", "default": "¿Por qué este producto?" },
    { "type": "text", "id": "subtitle", "label": "Subtítulo (opcional)" },
    { "type": "select", "id": "title_align", "label": "Alineación del encabezado", "options": [{"value":"left","label":"Izquierda"},{"value":"center","label":"Centro"}], "default": "center" },

    { "type": "header", "content": "Cuadrícula" },
    { "type": "select", "id": "columns", "label": "Columnas en desktop", "options": [{"value":"1","label":"1"},{"value":"2","label":"2"},{"value":"3","label":"3"}], "default": "2" },
    { "type": "range", "id": "gap", "label": "Espacio entre ítems (px)", "min": 8, "max": 48, "step": 4, "default": 20 },

    { "type": "header", "content": "Ícono" },
    { "type": "range", "id": "icon_size", "label": "Tamaño del ícono (px)", "min": 16, "max": 64, "step": 4, "default": 32 },
    { "type": "range", "id": "icon_gap", "label": "Espacio entre ícono y texto (px)", "min": 8, "max": 32, "step": 4, "default": 16 },

    { "type": "header", "content": "Texto de cada ítem" },
    { "type": "range", "id": "item_title_size", "label": "Tamaño título del ítem (px)", "min": 12, "max": 24, "step": 1, "default": 16 },
    { "type": "range", "id": "item_desc_size", "label": "Tamaño descripción del ítem (px)", "min": 11, "max": 18, "step": 1, "default": 14 },

    { "type": "header", "content": "Cuadro por ítem (estilo global)" },
    { "type": "range", "id": "box_border_width", "label": "Grosor del borde (px)", "min": 1, "max": 4, "step": 1, "default": 1 },
    { "type": "color", "id": "box_border_color", "label": "Color del borde", "default": "#E8E8E2" },
    { "type": "range", "id": "box_radius", "label": "Bordes redondeados del cuadro (px)", "min": 0, "max": 24, "step": 2, "default": 8 },
    { "type": "range", "id": "box_pad", "label": "Relleno interno del cuadro (px)", "min": 8, "max": 48, "step": 4, "default": 20 },

    { "type": "header", "content": "Espaciado y colores" },
    { "type": "range", "id": "py", "label": "Espacio vertical sección (px)", "min": 24, "max": 136, "step": 8, "default": 72 },
    { "type": "color", "id": "bg_color", "label": "Fondo sección", "default": "#FAFAF6" },
    { "type": "color", "id": "heading_color", "label": "Color títulos", "default": "#1a1a18" },
    { "type": "color", "id": "text_color", "label": "Color texto", "default": "#5a5a52" }
  ],
  "max_blocks": 12,
  "blocks": [
    {
      "type": "benefit",
      "name": "Beneficio",
      "settings": [
        { "type": "header", "content": "Ícono" },
        { "type": "text", "id": "icon_url", "label": "URL de imagen (pega el link de la imagen del ícono)" },
        { "type": "text", "id": "icon_emoji", "label": "O usa un emoji/símbolo (si no pegas URL arriba)", "default": "✓" },
        { "type": "header", "content": "Contenido" },
        { "type": "text", "id": "title", "label": "Título del beneficio", "default": "Alta calidad" },
        { "type": "textarea", "id": "description", "label": "Descripción (opcional)" },
        { "type": "header", "content": "Cuadro alrededor de este ítem" },
        { "type": "checkbox", "id": "show_box", "label": "Mostrar cuadro/borde en este ítem", "default": false },
        { "type": "color", "id": "box_bg", "label": "Color de fondo del cuadro", "default": "#FFFFFF" }
      ]
    }
  ],
  "presets": [{
    "name": "3 — Beneficios",
    "blocks": [
      { "type": "benefit", "settings": { "icon_emoji": "✓", "title": "Alta calidad", "description": "Elaborado con los mejores materiales." } },
      { "type": "benefit", "settings": { "icon_emoji": "⚡", "title": "Resultados rápidos", "description": "Notarás la diferencia desde el primer uso." } },
      { "type": "benefit", "settings": { "icon_emoji": "🛡️", "title": "Garantía total", "description": "Si no estás satisfecho, te devolvemos tu dinero." } },
      { "type": "benefit", "settings": { "icon_emoji": "🚚", "title": "Envío gratis a todo RD", "description": "Sin costo adicional en todo el país.", "show_box": false } }
    ]
  }]
}
{% endschema %}
