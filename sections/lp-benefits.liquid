{% if section.settings.image != blank %}
<div style="background:{{ section.settings.bg_color }}; padding:{{ section.settings.py }}px 0;">
  <img src="{{ section.settings.image | image_url: width: 1400 }}"
       alt="{{ section.settings.image.alt | default: '' | escape }}"
       style="width:100%; max-width:{{ section.settings.max_width }}px; height:auto; display:block; margin:0 auto;"
       loading="lazy">
</div>
{% endif %}

{% schema %}
{
  "name": "3 — Beneficios",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Ancho máximo (px)",
      "min": 300,
      "max": 1400,
      "step": 50,
      "default": 1400
    },
    {
      "type": "range",
      "id": "py",
      "label": "Espacio vertical (px)",
      "min": 0,
      "max": 48,
      "step": 4,
      "default": 0
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de fondo",
      "default": "#ffffff"
    }
  ],
  "presets": [{ "name": "3 — Beneficios" }]
}
{% endschema %}
