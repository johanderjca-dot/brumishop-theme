<section class="page-hero" style="--page-hero-h: {{ section.settings.height }}vh; --page-hero-h-mobile: {{ section.settings.height_mobile }}vh;">
  <div class="page-hero__media">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 1920 }}"
           srcset="{{ section.settings.image | image_url: width: 750 }} 750w,
                   {{ section.settings.image | image_url: width: 1200 }} 1200w,
                   {{ section.settings.image | image_url: width: 1920 }} 1920w"
           sizes="100vw"
           alt="{{ section.settings.heading | escape }}"
           width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}"
           loading="eager">
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'page-hero__placeholder' }}
    {%- endif -%}
    {%- if section.settings.overlay > 0 -%}
      <div class="page-hero__overlay" style="opacity: {{ section.settings.overlay | divided_by: 100.0 }}"></div>
    {%- endif -%}
  </div>

  {%- if section.settings.heading != blank -%}
    <h1 class="page-hero__heading" style="color: {{ section.settings.text_color }}">{{ section.settings.heading }}</h1>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Encabezado de página",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen de fondo" },
    { "type": "range", "id": "overlay", "min": 0, "max": 80, "step": 5, "unit": "%", "label": "Oscurecer la imagen", "default": 15 },
    { "type": "range", "id": "height", "min": 20, "max": 80, "step": 5, "unit": "vh", "label": "Altura en escritorio", "default": 40 },
    { "type": "range", "id": "height_mobile", "min": 20, "max": 80, "step": 5, "unit": "vh", "label": "Altura en móvil", "default": 32 },
    { "type": "text", "id": "heading", "label": "Título", "default": "Contacto" },
    { "type": "color", "id": "text_color", "label": "Color del título", "default": "#FFFFFF" }
  ],
  "presets": [{ "name": "Encabezado de página" }]
}
{% endschema %}
