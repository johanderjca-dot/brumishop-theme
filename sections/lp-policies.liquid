<style>
  .lp-policy-accordion summary { cursor: pointer; list-style: none; }
  .lp-policy-accordion summary::-webkit-details-marker { display: none; }
  .lp-policy-accordion[open] .lp-policy-arrow { transform: rotate(180deg); }
  .lp-policy-arrow { transition: transform .25s ease; display: inline-block; }
  .lp-policy-content p { margin-bottom: 0.75rem; line-height: 1.75; }
  .lp-policy-content ul { margin: 0.5rem 0 0.75rem 1.5rem; }
  .lp-policy-content li { margin-bottom: 0.35rem; }
</style>

{% if section.blocks.size > 0 %}
<section style="background:{{ section.settings.bg_color }}; padding:{{ section.settings.py }}px 0; border-top:1px solid {{ section.settings.border_color }};">
  <div style="max-width:{{ section.settings.max_width }}px; margin:0 auto; padding:0 1.5rem;">

    {% if section.settings.title != blank %}
      <h2 style="font-family:'Cormorant Garamond',Georgia,serif; font-size:clamp(1.5rem,2.5vw,2.25rem); font-weight:600; color:{{ section.settings.heading_color }}; margin-bottom:1.75rem; text-align:{{ section.settings.title_align }};">
        {{ section.settings.title }}
      </h2>
    {% endif %}

    <div style="display:flex; flex-direction:column; gap:0;">
      {% for block in section.blocks %}
        <details class="lp-policy-accordion" {{ block.shopify_attributes }}
                 style="border-bottom:1px solid {{ section.settings.border_color }}; {% if forloop.first %}border-top:1px solid {{ section.settings.border_color }};{% endif %}">
          <summary style="padding:1.1rem 0; display:flex; align-items:center; justify-content:space-between;">
            <span style="font-size:0.9rem; font-weight:600; color:{{ section.settings.heading_color }};">
              {% if block.settings.icon != blank %}{{ block.settings.icon }}&nbsp;&nbsp;{% endif %}{{ block.settings.title }}
            </span>
            <span class="lp-policy-arrow" style="color:{{ section.settings.text_color }}; font-size:0.8rem;">▼</span>
          </summary>
          <div class="lp-policy-content" style="padding:0 0 1.25rem; font-size:0.875rem; color:{{ section.settings.text_color }}; line-height:1.75;">
            {{ block.settings.content }}
          </div>
        </details>
      {% endfor %}
    </div>

  </div>
</section>
{% endif %}

{% schema %}
{
  "name": "Políticas y Devoluciones",
  "settings": [
    { "type": "text", "id": "title", "label": "Título de la sección", "default": "Políticas y devoluciones" },
    { "type": "select", "id": "title_align", "label": "Alineación título", "options": [{"value":"left","label":"Izquierda"},{"value":"center","label":"Centro"}], "default": "left" },
    { "type": "range", "id": "max_width", "label": "Ancho máximo (px)", "min": 500, "max": 1100, "step": 20, "default": 780 },
    { "type": "range", "id": "py", "label": "Espacio vertical (px)", "min": 32, "max": 120, "step": 8, "default": 64 },
    { "type": "color", "id": "bg_color", "label": "Fondo", "default": "#FFFFFF" },
    { "type": "color", "id": "border_color", "label": "Color bordes", "default": "#E8E8E2" },
    { "type": "color", "id": "heading_color", "label": "Color títulos", "default": "#1a1a18" },
    { "type": "color", "id": "text_color", "label": "Color texto", "default": "#5a5a52" }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "policy",
      "name": "Política",
      "settings": [
        { "type": "text", "id": "icon", "label": "Ícono o emoji (opcional)", "default": "↩" },
        { "type": "text", "id": "title", "label": "Título", "default": "Política de devoluciones" },
        { "type": "richtext", "id": "content", "label": "Contenido", "default": "<p>Aceptamos devoluciones dentro de los 30 días posteriores a la compra. El producto debe estar en su estado original sin uso.</p><p>Para iniciar una devolución, contáctanos por WhatsApp o correo electrónico.</p>" }
      ]
    }
  ],
  "presets": [{
    "name": "Políticas y Devoluciones",
    "blocks": [
      { "type": "policy", "settings": { "icon": "↩", "title": "Política de devoluciones", "content": "<p>Aceptamos devoluciones dentro de los 30 días posteriores a la compra. El producto debe estar en su estado original, sin uso y en su empaque original.</p>" } },
      { "type": "policy", "settings": { "icon": "🔄", "title": "Cambios e intercambios", "content": "<p>Puedes cambiar tu producto por otro de igual o mayor valor pagando la diferencia. El proceso tarda entre 3-5 días hábiles.</p>" } },
      { "type": "policy", "settings": { "icon": "💳", "title": "Reembolsos", "content": "<p>Los reembolsos se procesan en 5-7 días hábiles al mismo método de pago utilizado en la compra.</p>" } }
    ]
  }]
}
{% endschema %}
