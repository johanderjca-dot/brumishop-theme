<section class="section-pad faq">
  <div class="page-width">
    <div class="cat-head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="cat-head__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="cat-head__title">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="faq__list">
        {%- for block in section.blocks -%}
          <details class="faq__item" {{ block.shopify_attributes }}>
            <summary>{{ block.settings.question }}</summary>
            <div class="rte">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Preguntas frecuentes",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Etiqueta pequeña", "default": "Todo lo que necesitas saber" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Preguntas frecuentes" }
  ],
  "blocks": [
    { "type": "faq", "name": "Pregunta", "settings": [
      { "type": "text", "id": "question", "label": "Pregunta", "default": "¿Es seguro usar este producto?" },
      { "type": "richtext", "id": "answer", "label": "Respuesta" }
    ]}
  ],
  "presets": [{
    "name": "Preguntas frecuentes",
    "blocks": [ { "type": "faq" }, { "type": "faq" }, { "type": "faq" } ]
  }]
}
{% endschema %}
