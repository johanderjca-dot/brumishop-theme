<footer style="border-top:1px solid {{ section.settings.border_color }}; background:{{ section.settings.bg_color }}; padding:4rem 0 2rem;">
  <div style="max-width:1320px; margin:0 auto; padding:0 1.5rem;">

    <div style="display:grid; grid-template-columns:1fr; gap:2.5rem;"
         class="brumi-footer-grid">
      <style>
        @media (min-width:640px) { .brumi-footer-grid { grid-template-columns: repeat(2, 1fr) !important; } }
        @media (min-width:1024px) { .brumi-footer-grid { grid-template-columns: 2fr repeat(3, 1fr) !important; } }
      </style>

      <!-- Brand column -->
      <div>
        {% if section.settings.logo != blank %}
          <img src="{{ section.settings.logo | image_url: width: 300 }}"
               alt="{{ shop.name }}"
               style="height:{{ section.settings.logo_height }}px; width:auto; display:block; margin-bottom:1rem;">
        {% else %}
          <a href="{{ routes.root_url }}"
             style="font-family:'Cormorant Garamond',Georgia,serif; font-size:1.5rem; font-weight:600; letter-spacing:0.15em; color:{{ section.settings.heading_color }}; text-decoration:none; display:block; margin-bottom:1rem;">
            {{ section.settings.brand_name | default: shop.name | upcase }}
          </a>
        {% endif %}
        {% if section.settings.tagline != blank %}
          <p style="font-size:0.8rem; color:{{ section.settings.text_color }}; line-height:1.7; max-width:26ch;">
            {{ section.settings.tagline }}
          </p>
        {% endif %}

        <!-- Social links -->
        {% if section.settings.instagram != blank or section.settings.whatsapp != blank or section.settings.facebook != blank or section.settings.tiktok != blank %}
          <div style="display:flex; gap:0.75rem; margin-top:1.25rem; flex-wrap:wrap;">
            {% if section.settings.instagram != blank %}
              <a href="{{ section.settings.instagram }}" target="_blank" rel="noopener"
                 style="display:flex; align-items:center; justify-content:center; width:2rem; height:2rem; border:1px solid {{ section.settings.border_color }}; border-radius:50%; color:{{ section.settings.text_color }}; transition:background .15s, color .15s;"
                 onmouseover="this.style.background='{{ section.settings.heading_color }}';this.style.color='#fff';this.style.borderColor='{{ section.settings.heading_color }}'"
                 onmouseout="this.style.background='';this.style.color='{{ section.settings.text_color }}';this.style.borderColor='{{ section.settings.border_color }}'">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"/></svg>
              </a>
            {% endif %}
            {% if section.settings.whatsapp != blank %}
              <a href="https://wa.me/{{ section.settings.whatsapp | remove: '+' | remove: ' ' | remove: '-' }}" target="_blank" rel="noopener"
                 style="display:flex; align-items:center; justify-content:center; width:2rem; height:2rem; border:1px solid {{ section.settings.border_color }}; border-radius:50%; color:{{ section.settings.text_color }}; transition:background .15s, color .15s;"
                 onmouseover="this.style.background='{{ section.settings.heading_color }}';this.style.color='#fff';this.style.borderColor='{{ section.settings.heading_color }}'"
                 onmouseout="this.style.background='';this.style.color='{{ section.settings.text_color }}';this.style.borderColor='{{ section.settings.border_color }}'">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
              </a>
            {% endif %}
            {% if section.settings.facebook != blank %}
              <a href="{{ section.settings.facebook }}" target="_blank" rel="noopener"
                 style="display:flex; align-items:center; justify-content:center; width:2rem; height:2rem; border:1px solid {{ section.settings.border_color }}; border-radius:50%; color:{{ section.settings.text_color }}; transition:background .15s, color .15s;"
                 onmouseover="this.style.background='{{ section.settings.heading_color }}';this.style.color='#fff';this.style.borderColor='{{ section.settings.heading_color }}'"
                 onmouseout="this.style.background='';this.style.color='{{ section.settings.text_color }}';this.style.borderColor='{{ section.settings.border_color }}'">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
              </a>
            {% endif %}
            {% if section.settings.tiktok != blank %}
              <a href="{{ section.settings.tiktok }}" target="_blank" rel="noopener"
                 style="display:flex; align-items:center; justify-content:center; width:2rem; height:2rem; border:1px solid {{ section.settings.border_color }}; border-radius:50%; color:{{ section.settings.text_color }}; transition:background .15s, color .15s;"
                 onmouseover="this.style.background='{{ section.settings.heading_color }}';this.style.color='#fff';this.style.borderColor='{{ section.settings.heading_color }}'"
                 onmouseout="this.style.background='';this.style.color='{{ section.settings.text_color }}';this.style.borderColor='{{ section.settings.border_color }}'">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.76a4.85 4.85 0 0 1-1.01-.07z"/></svg>
              </a>
            {% endif %}
          </div>
        {% endif %}
      </div>

      <!-- Link columns (blocks) -->
      {% for block in section.blocks %}
        <div {{ block.shopify_attributes }}>
          <h4 style="font-size:0.65rem; font-weight:700; letter-spacing:0.18em; text-transform:uppercase; color:{{ section.settings.heading_color }}; margin:0 0 1.1rem;">
            {{ block.settings.title }}
          </h4>
          <ul style="list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:0.65rem;">
            {% assign links = block.settings.links | split: ',' %}
            {% for item in links %}
              {% assign parts = item | strip | split: '|' %}
              {% if parts[1] != blank %}
                <li><a href="{{ parts[1] | strip }}" style="font-size:0.8rem; color:{{ section.settings.text_color }}; text-decoration:none; transition:color .15s;"
                       onmouseover="this.style.color='{{ section.settings.heading_color }}'" onmouseout="this.style.color='{{ section.settings.text_color }}'">{{ parts[0] | strip }}</a></li>
              {% else %}
                <li><span style="font-size:0.8rem; color:{{ section.settings.text_color }};">{{ parts[0] | strip }}</span></li>
              {% endif %}
            {% endfor %}
          </ul>
        </div>
      {% endfor %}
    </div>

    <!-- Bottom bar -->
    <div style="border-top:1px solid {{ section.settings.border_color }}; margin-top:3rem; padding-top:1.5rem; display:flex; flex-direction:column; gap:0.75rem; align-items:center; text-align:center;">
      <p style="font-size:0.7rem; color:{{ section.settings.text_color }}; margin:0;">
        {{ section.settings.copyright | default: '© 2025 — Todos los derechos reservados.' | replace: '{year}', 'now' | date: '%Y' }}
      </p>

      {% if section.settings.show_payment_methods %}
        <div style="display:flex; align-items:center; gap:0.5rem; flex-wrap:wrap; justify-content:center;">
          {% if section.settings.pay_cod %}
            <span style="font-size:0.65rem; font-weight:700; border:1px solid {{ section.settings.border_color }}; padding:0.2rem 0.6rem; border-radius:3px; color:{{ section.settings.text_color }};">CONTRA ENTREGA</span>
          {% endif %}
          {% if section.settings.pay_visa %}
            <span style="font-size:0.65rem; font-weight:700; border:1px solid {{ section.settings.border_color }}; padding:0.2rem 0.6rem; border-radius:3px; color:{{ section.settings.text_color }};">VISA</span>
          {% endif %}
          {% if section.settings.pay_mc %}
            <span style="font-size:0.65rem; font-weight:700; border:1px solid {{ section.settings.border_color }}; padding:0.2rem 0.6rem; border-radius:3px; color:{{ section.settings.text_color }};">MASTERCARD</span>
          {% endif %}
          {% if section.settings.pay_amex %}
            <span style="font-size:0.65rem; font-weight:700; border:1px solid {{ section.settings.border_color }}; padding:0.2rem 0.6rem; border-radius:3px; color:{{ section.settings.text_color }};">AMEX</span>
          {% endif %}
          {% if section.settings.pay_paypal %}
            <span style="font-size:0.65rem; font-weight:700; border:1px solid {{ section.settings.border_color }}; padding:0.2rem 0.6rem; border-radius:3px; color:{{ section.settings.text_color }};">PAYPAL</span>
          {% endif %}
          {% if section.settings.pay_transfer %}
            <span style="font-size:0.65rem; font-weight:700; border:1px solid {{ section.settings.border_color }}; padding:0.2rem 0.6rem; border-radius:3px; color:{{ section.settings.text_color }};">TRANSFERENCIA</span>
          {% endif %}
        </div>
      {% endif %}
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "header", "content": "Marca" },
    { "type": "image_picker", "id": "logo", "label": "Logo (opcional)" },
    { "type": "range", "id": "logo_height", "label": "Altura del logo (px)", "min": 20, "max": 80, "step": 2, "default": 32 },
    { "type": "text", "id": "brand_name", "label": "Nombre de la marca (si no hay logo)", "default": "BrumiShop" },
    { "type": "textarea", "id": "tagline", "label": "Descripción corta", "default": "Tu tienda de confianza. Productos de calidad para el día a día." },
    { "type": "header", "content": "Redes sociales" },
    { "type": "text", "id": "instagram", "label": "URL Instagram" },
    { "type": "text", "id": "whatsapp", "label": "WhatsApp (número con código de país, ej: +18091234567)" },
    { "type": "text", "id": "facebook", "label": "URL Facebook" },
    { "type": "text", "id": "tiktok", "label": "URL TikTok" },
    { "type": "header", "content": "Pie de página" },
    { "type": "text", "id": "copyright", "label": "Texto de derechos de autor", "default": "© 2025 BrumiShop — Todos los derechos reservados." },
    { "type": "header", "content": "Métodos de pago" },
    { "type": "checkbox", "id": "show_payment_methods", "label": "Mostrar métodos de pago", "default": true },
    { "type": "checkbox", "id": "pay_cod", "label": "Pago contra entrega", "default": true },
    { "type": "checkbox", "id": "pay_visa", "label": "Visa", "default": false },
    { "type": "checkbox", "id": "pay_mc", "label": "Mastercard", "default": false },
    { "type": "checkbox", "id": "pay_amex", "label": "American Express", "default": false },
    { "type": "checkbox", "id": "pay_paypal", "label": "PayPal", "default": false },
    { "type": "checkbox", "id": "pay_transfer", "label": "Transferencia bancaria", "default": false },
    { "type": "header", "content": "Colores" },
    { "type": "color", "id": "bg_color", "label": "Fondo", "default": "#FAFAF6" },
    { "type": "color", "id": "heading_color", "label": "Color títulos", "default": "#1a1a18" },
    { "type": "color", "id": "text_color", "label": "Color texto", "default": "#6a6a62" },
    { "type": "color", "id": "border_color", "label": "Color bordes", "default": "#E8E8E2" }
  ],
  "blocks": [
    {
      "type": "link_column",
      "name": "Columna de links",
      "settings": [
        { "type": "text", "id": "title", "label": "Título de la columna", "default": "Ayuda" },
        { "type": "textarea", "id": "links", "label": "Links (uno por línea: Texto | /url)", "default": "FAQ | /pages/faq,Envíos y devoluciones | /pages/envios,Contacto | /pages/contacto" }
      ]
    }
  ],
  "presets": [{
    "name": "Footer",
    "blocks": [
      { "type": "link_column", "settings": { "title": "Ayuda", "links": "FAQ | /pages/faq,Envíos | /pages/envios,Devoluciones | /pages/devoluciones,Contacto | /pages/contacto" } },
      { "type": "link_column", "settings": { "title": "Tienda", "links": "Todos los productos | /collections/all,Ofertas | /collections/ofertas,Novedades | /collections/nuevos" } },
      { "type": "link_column", "settings": { "title": "Legal", "links": "Privacidad | /policies/privacy-policy,Términos | /policies/terms-of-service" } }
    ]
  }]
}
{% endschema %}
