<footer class="footer footer--dark">
  <div class="page-width">
    <div class="footer__grid">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'menu' -%}
            <div class="footer__col" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}<h3>{{ block.settings.heading }}</h3>{%- endif -%}
              <ul>
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            </div>
          {%- when 'text' -%}
            <div class="footer__col" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}<h3>{{ block.settings.heading }}</h3>{%- endif -%}
              <div class="rte">{{ block.settings.content }}</div>
            </div>
        {%- endcase -%}
      {%- endfor -%}

      {%- if settings.social_instagram != blank or settings.social_facebook != blank or settings.social_tiktok != blank or settings.social_whatsapp != blank -%}
        <div class="footer__col">
          <h3>Social</h3>
          <ul>
            {%- if settings.social_instagram != blank -%}<li><a href="{{ settings.social_instagram }}" target="_blank" rel="noopener">Instagram</a></li>{%- endif -%}
            {%- if settings.social_facebook != blank -%}<li><a href="{{ settings.social_facebook }}" target="_blank" rel="noopener">Facebook</a></li>{%- endif -%}
            {%- if settings.social_tiktok != blank -%}<li><a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener">TikTok</a></li>{%- endif -%}
            {%- if settings.social_whatsapp != blank -%}<li><a href="{{ settings.social_whatsapp }}" target="_blank" rel="noopener">WhatsApp</a></li>{%- endif -%}
          </ul>
        </div>
      {%- endif -%}
    </div>

    <div class="footer__bottom">
      <div class="footer__bottom-row">
        <span class="footer__copyright">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>

        {%- if localization.available_countries.size > 1 or localization.available_languages.size > 1 -%}
          {%- form 'localization', id: 'FooterLocalizationForm', class: 'footer__locale' -%}
            {%- if localization.available_countries.size > 1 -%}
              <select name="country_code" class="footer__locale-select" onchange="this.form.submit()" aria-label="País / moneda">
                {%- for country in localization.available_countries -%}
                  <option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>
                    {{ country.iso_code }} / {{ country.currency.iso_code }}
                  </option>
                {%- endfor -%}
              </select>
            {%- endif -%}
            {%- if localization.available_languages.size > 1 -%}
              <select name="locale_code" class="footer__locale-select" onchange="this.form.submit()" aria-label="Idioma">
                {%- for lang in localization.available_languages -%}
                  <option value="{{ lang.iso_code }}" {% if lang.iso_code == localization.language.iso_code %}selected{% endif %}>
                    {{ lang.iso_code | upcase }}
                  </option>
                {%- endfor -%}
              </select>
            {%- endif -%}
          {%- endform -%}
        {%- endif -%}

        {%- if settings.social_facebook != blank or settings.social_instagram != blank or settings.social_tiktok != blank or settings.social_whatsapp != blank -%}
          <div class="footer__socials">
            {%- if settings.social_facebook != blank -%}
              <a class="footer__social-icon" href="{{ settings.social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 8.5h2.5V5h-2.5C12.5 5 11 6.6 11 9v2H8.5v3.5H11V22h3.5v-7.5H17l1-3.5h-3.5V9c0-.4.3-.5.5-.5Z" fill="currentColor"/></svg>
              </a>
            {%- endif -%}
            {%- if settings.social_instagram != blank -%}
              <a class="footer__social-icon" href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.6"/><circle cx="17.2" cy="6.8" r="1.1" fill="currentColor"/></svg>
              </a>
            {%- endif -%}
            {%- if settings.social_tiktok != blank -%}
              <a class="footer__social-icon" href="{{ settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M14 4v10.2a2.6 2.6 0 1 1-2.2-2.57V9.1A5.1 5.1 0 1 0 16.5 14V9.4c1 .6 2.1.9 3.3.9V7.8c-1.6 0-3-.8-3.8-2A4 4 0 0 1 16 4h-2Z" fill="currentColor"/></svg>
              </a>
            {%- endif -%}
            {%- if settings.social_whatsapp != blank -%}
              <a class="footer__social-icon" href="{{ settings.social_whatsapp }}" target="_blank" rel="noopener" aria-label="WhatsApp">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3.5a8.5 8.5 0 0 0-7.3 12.8L3.5 20.5l4.3-1.1A8.5 8.5 0 1 0 12 3.5Z" stroke="currentColor" stroke-width="1.4"/><path d="M8.5 8.8c.2-.5.5-.5.7-.5h.5c.2 0 .4 0 .5.4.2.4.6 1.4.6 1.5.1.1.1.3 0 .4-.1.2-.2.3-.3.4l-.4.4c-.1.1-.2.3-.1.5.2.4.7 1.1 1.4 1.7.9.8 1.6 1 1.9 1.2.2.1.4.1.5-.1l.5-.6c.2-.2.3-.2.5-.1l1.3.6c.2.1.3.2.3.3.1.4-.1 1.1-.3 1.4-.3.4-1 .8-1.7.8-.6 0-2-.2-3.7-1.7C9 15.2 8.2 13.7 8 13.3c-.1-.4-.7-1.5-.7-2.8 0-.9.5-1.5.7-1.7Z" fill="currentColor"/></svg>
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.show_payment -%}
          <div class="footer__payment">
            {%- for type in shop.enabled_payment_types -%}
              {{ type | payment_type_svg_tag: class: 'footer__payment-icon' }}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- if section.settings.wordmark != blank -%}
      <div class="footer__wordmark-huge">{{ section.settings.wordmark }}</div>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "Pie de página",
  "settings": [
    { "type": "checkbox", "id": "show_payment", "label": "Mostrar métodos de pago", "default": true },
    { "type": "text", "id": "wordmark", "label": "Nombre grande al final", "default": "BrumiShop", "info": "Se muestra enorme, de borde a borde, al final del pie de página." }
  ],
  "blocks": [
    { "type": "menu", "name": "Menú", "settings": [
      { "type": "text", "id": "heading", "label": "Título", "default": "Tienda" },
      { "type": "link_list", "id": "menu", "label": "Menú", "default": "footer" }
    ]},
    { "type": "text", "name": "Texto", "settings": [
      { "type": "text", "id": "heading", "label": "Título", "default": "Sobre nosotros" },
      { "type": "richtext", "id": "content", "label": "Contenido" }
    ]}
  ],
  "default": { "blocks": [ { "type": "menu" }, { "type": "menu" } ] },
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
