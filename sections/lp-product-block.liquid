{% assign cv = product.selected_or_first_available_variant %}
{% assign has_fake = false %}
{% if section.settings.fake_price_amount > 0 %}
  {% assign fake_cents = section.settings.fake_price_amount | times: 100 %}
  {% if fake_cents > cv.price %}
    {% assign has_fake = true %}
    {% assign savings_cents = fake_cents | minus: cv.price %}
  {% endif %}
{% endif %}

<style>
  .lpb-grid { display: block; }

  .lpb-trust    { padding: 8px 16px; background: #ffffff; }
  .lpb-desc     { padding: 16px 16px 8px; background: #ffffff; }
  .lpb-benefits { padding: 4px 16px 14px; background: #fafaf6; }
  .lpb-price    { padding: 12px 16px; background: #ffffff; }

  .lpb-tb-box {
    display: grid;
    grid-template-columns: 1fr 1px 1fr;
    align-items: stretch;
    height: 70px;
    overflow: hidden;
  }
  .lpb-tb-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 0 8px;
    overflow: hidden;
  }
  .lpb-tb-icon img { width: 28px; height: 28px; object-fit: contain; display: block; }
  .lpb-tb-title { font-weight: 700; font-size: 11px; color: #1a1a18; line-height: 1.2; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .lpb-tb-sub   { font-size: 9.5px; color: #1a1a18; opacity: 0.6; line-height: 1.2; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .lpb-tb-divider { background: #e0e0da; margin: 12px 0; }

  .lpb-desc-content p { margin-bottom: 0.25rem; line-height: 1.5; }
  .lpb-desc-content p:last-child { margin-bottom: 0; }

  .lpb-ben-list { display: flex; flex-direction: column; gap: 8px; }
  .lpb-ben-item { display: flex; align-items: flex-start; gap: 8px; }

  @media (min-width: 768px) {
    .lpb-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
    .lpb-trust    { grid-column: 1; grid-row: 1; }
    .lpb-desc     { grid-column: 2; grid-row: 1; }
    .lpb-benefits { grid-column: 2; grid-row: 2; }
    .lpb-price    { grid-column: 1; grid-row: 2; }
  }
</style>

<div class="lpb-grid">

  <!-- Trust Badges — izquierda arriba -->
  <div class="lpb-trust">
    <div class="lpb-tb-box">
      <div class="lpb-tb-item">
        {% if section.settings.badge1_icon != blank %}
          <div class="lpb-tb-icon"><img src="{{ section.settings.badge1_icon | image_url: width: 80 }}" alt=""></div>
        {% endif %}
        <div>
          <div class="lpb-tb-title">{{ section.settings.badge1_title }}</div>
          <div class="lpb-tb-sub">{{ section.settings.badge1_sub }}</div>
        </div>
      </div>
      <div class="lpb-tb-divider"></div>
      <div class="lpb-tb-item">
        {% if section.settings.badge2_icon != blank %}
          <div class="lpb-tb-icon"><img src="{{ section.settings.badge2_icon | image_url: width: 80 }}" alt=""></div>
        {% endif %}
        <div>
          <div class="lpb-tb-title">{{ section.settings.badge2_title }}</div>
          <div class="lpb-tb-sub">{{ section.settings.badge2_sub }}</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Descripción — derecha arriba -->
  <div class="lpb-desc">
    {% if section.settings.title != blank %}
      <div style="font-size:{{ section.settings.title_size }}px; font-weight:700; color:{{ section.settings.title_color }}; margin-bottom:8px; line-height:1.2;">
        {{ section.settings.title }}
      </div>
    {% endif %}
    <div class="lpb-desc-content" style="font-size:{{ section.settings.font_size }}px; color:#1a1a18; margin-bottom:8px;">
      {% if section.settings.content != blank %}
        {{ section.settings.content }}
      {% elsif product.description != blank %}
        {{ product.description }}
      {% endif %}
    </div>
    {% if section.settings.rating_text != blank %}
      <a href="#resenas" style="display:inline-flex; align-items:center; gap:6px; text-decoration:none; margin-top:4px;">
        <span style="color:{{ section.settings.star_color }}; font-size:{{ section.settings.star_size }}px; letter-spacing:2px; line-height:1;">★★★★★</span>
        <em style="font-size:{{ section.settings.star_size | minus: 2 }}px; color:#6a6a62; font-style:italic;">{{ section.settings.rating_text }}</em>
      </a>
    {% endif %}
  </div>

  <!-- Beneficios — derecha abajo -->
  <div class="lpb-benefits">
    {% if section.blocks.size > 0 %}
      <div class="lpb-ben-list">
        {% for block in section.blocks %}
          <div class="lpb-ben-item" {{ block.shopify_attributes }}>
            <span style="font-size:15px; flex-shrink:0; color:#1a1a18; line-height:1.4;">{{ block.settings.icon_emoji }}</span>
            <span style="font-size:15px; font-weight:600; color:#1a1a18; line-height:1.3;">{{ block.settings.title }}</span>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>

  <!-- Precio y Oferta — izquierda abajo -->
  <div class="lpb-price">
    <div style="display:flex; align-items:baseline; gap:0.6rem; flex-wrap:wrap; margin-bottom:{% if has_fake %}0.35rem{% else %}0{% endif %};">
      <span style="font-size:{{ section.settings.price_size }}px; font-weight:700; color:{{ section.settings.price_color }}; line-height:1;">
        {{ cv.price | money }}
      </span>
      {% if has_fake %}
        <span style="font-size:{{ section.settings.price_size | times: 0.6 | round }}px; color:#a0a09a; text-decoration:line-through; line-height:1;">
          {{ fake_cents | money }}
        </span>
      {% elsif cv.compare_at_price > cv.price %}
        <span style="font-size:{{ section.settings.price_size | times: 0.6 | round }}px; color:#a0a09a; text-decoration:line-through; line-height:1;">
          {{ cv.compare_at_price | money }}
        </span>
      {% endif %}
    </div>
    {% if has_fake %}
      <div style="display:inline-flex; align-items:center; background:{{ section.settings.savings_bg }}; border-radius:4px; padding:0.2rem 0.6rem; margin-bottom:{% if section.settings.urgency_qty > 0 %}0.35rem{% else %}0{% endif %};">
        <span style="color:{{ section.settings.savings_color }}; font-size:0.75rem; font-weight:700;">Ahorra {{ savings_cents | money }}</span>
      </div>
    {% endif %}
    {% if section.settings.urgency_qty > 0 %}
      <p style="font-size:0.78rem; color:{{ section.settings.urgency_color }}; margin:0.25rem 0 0; font-weight:600;">
        {{ section.settings.urgency_prefix | strip }} {{ section.settings.urgency_qty }} {{ section.settings.urgency_suffix | strip }}
      </p>
    {% endif %}
  </div>

</div>

{% schema %}
{
  "name": "Bloque Producto",
  "settings": [
    { "type": "header", "content": "Trust Badges" },
    { "type": "image_picker", "id": "badge1_icon", "label": "Badge 1 — Ícono" },
    { "type": "text", "id": "badge1_title", "label": "Badge 1 — Título", "default": "Envío Gratis" },
    { "type": "text", "id": "badge1_sub", "label": "Badge 1 — Subtítulo", "default": "Entrega en 24-48h (Todo RD)" },
    { "type": "image_picker", "id": "badge2_icon", "label": "Badge 2 — Ícono" },
    { "type": "text", "id": "badge2_title", "label": "Badge 2 — Título", "default": "Pagas al Recibir" },
    { "type": "text", "id": "badge2_sub", "label": "Badge 2 — Subtítulo", "default": "Efectivo o Transferencia" },
    { "type": "header", "content": "Descripción" },
    { "type": "text", "id": "title", "label": "Título del producto" },
    { "type": "range", "id": "title_size", "label": "Tamaño título (px)", "min": 14, "max": 48, "step": 1, "default": 22 },
    { "type": "color", "id": "title_color", "label": "Color título", "default": "#1a1a18" },
    { "type": "richtext", "id": "content", "label": "Contenido (vacío = descripción de Shopify)" },
    { "type": "range", "id": "font_size", "label": "Tamaño texto (px)", "min": 12, "max": 24, "step": 1, "default": 15 },
    { "type": "header", "content": "Reseñas" },
    { "type": "text", "id": "rating_text", "label": "Texto (ej: 127 reseñas) — las ★ van solas. Vacío = oculto." },
    { "type": "range", "id": "star_size", "label": "Tamaño estrellas (px)", "min": 10, "max": 28, "step": 1, "default": 14 },
    { "type": "color", "id": "star_color", "label": "Color estrellas", "default": "#F4A327" },
    { "type": "header", "content": "Precio y Oferta" },
    { "type": "range", "id": "price_size", "label": "Tamaño del precio (px)", "min": 14, "max": 48, "step": 1, "default": 22 },
    { "type": "color", "id": "price_color", "label": "Color del precio", "default": "#1a1a18" },
    { "type": "number", "id": "fake_price_amount", "label": "Precio tachado — solo el número (ej: 2500)", "default": 0 },
    { "type": "color", "id": "savings_bg", "label": "Fondo badge ahorro", "default": "#F0FFF4" },
    { "type": "color", "id": "savings_color", "label": "Color texto ahorro", "default": "#2d7a3a" },
    { "type": "header", "content": "Urgencia (0 = no aparece)" },
    { "type": "range", "id": "urgency_qty", "label": "Cantidad unidades", "min": 0, "max": 99, "step": 1, "default": 0 },
    { "type": "text", "id": "urgency_prefix", "label": "Texto antes del número", "default": "⚡ Últimas" },
    { "type": "text", "id": "urgency_suffix", "label": "Texto después del número", "default": "unidades disponibles" },
    { "type": "color", "id": "urgency_color", "label": "Color urgencia", "default": "#c0392b" }
  ],
  "max_blocks": 12,
  "blocks": [
    {
      "type": "benefit",
      "name": "Beneficio",
      "settings": [
        { "type": "text", "id": "icon_emoji", "label": "Emoji o símbolo", "default": "✓" },
        { "type": "text", "id": "title", "label": "Texto del beneficio", "default": "Beneficio" }
      ]
    }
  ],
  "presets": [{ "name": "Bloque Producto" }]
}
{% endschema %}
