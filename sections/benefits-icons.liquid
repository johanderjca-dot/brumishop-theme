<section class="section-pad" style="background: {{ section.settings.bg_color }}">
  <div class="page-width">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="cat-head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="cat-head__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="cat-head__title">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="features__wrap">
      <div class="features__media">
        {%- if section.settings.video_alpha_url != blank -%}
          <video class="features__alpha-video" autoplay muted loop playsinline>
            <source src="{{ section.settings.video_alpha_url }}">
          </video>
          {%- if section.settings.video_alpha_poster_url != blank -%}
            {%- comment -%} el video con canal alfa no funciona en la mayoría de
              navegadores móviles (sale negro) — en móvil se muestra esta
              imagen fija en su lugar, ver .features__alpha-video en el CSS {%- endcomment -%}
            <img class="features__alpha-poster" src="{{ section.settings.video_alpha_poster_url }}" alt="" width="900" height="506" loading="lazy">
          {%- endif -%}
        {%- elsif section.settings.video != blank -%}
          {{ section.settings.video
            | video_tag:
              image_size: '900x',
              autoplay: true,
              loop: true,
              muted: true,
              controls: false,
              playsinline: true
          }}
        {%- elsif section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 900 }}"
               srcset="{{ section.settings.image | image_url: width: 500 }} 500w, {{ section.settings.image | image_url: width: 900 }} 900w"
               sizes="(min-width: 990px) 30vw, 70vw"
               alt="{{ section.settings.heading | escape }}"
               width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}"
               loading="lazy">
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag }}
        {%- endif -%}
      </div>

      <div class="features__items">
        {%- for block in section.blocks -%}
          <div class="features__item" {{ block.shopify_attributes }}>
            <div class="features__icon">
              {%- if block.settings.icon != blank -%}
                <img src="{{ block.settings.icon | image_url: width: 128 }}"
                     alt=""
                     width="{{ block.settings.icon.width }}" height="{{ block.settings.icon.height }}"
                     loading="lazy">
              {%- else -%}
                {% render 'icon-checkmark' %}
              {%- endif -%}
            </div>
            {%- if block.settings.title != blank -%}<p class="features__title">{{ block.settings.title }}</p>{%- endif -%}
            {%- if block.settings.text != blank -%}<p class="features__desc">{{ block.settings.text }}</p>{%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Beneficios",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Etiqueta pequeña (opcional)" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Calidad respaldada por la ciencia" },
    { "type": "image_picker", "id": "image", "label": "Imagen central" },
    { "type": "video", "id": "video", "label": "Video central (opcional)", "info": "Si lo subes, reemplaza a la imagen. Se reproduce sin sonido y en bucle." },
    { "type": "text", "id": "video_alpha_url", "label": "URL de video con fondo transparente (opcional)", "info": "Para videos con canal alfa (fondo transparente) — Shopify no los soporta si los subes aquí arriba, porque los vuelve a codificar y pierde la transparencia. Sube el archivo .webm a Configuración → Archivos (no aquí), copia su enlace y pégalo en este campo. Si lo llenas, reemplaza a todo lo demás." },
    { "type": "text", "id": "video_alpha_poster_url", "label": "Imagen de respaldo para móvil (URL, opcional)", "info": "El video con canal alfa no funciona en la mayoría de navegadores de celular (sale negro). Sube una imagen PNG con fondo transparente (un cuadro del video sirve) por el mismo método que el video, y pega su enlace aquí — se usa solo en pantallas pequeñas." },
    { "type": "color", "id": "bg_color", "label": "Color de fondo", "default": "#FBF6EE" }
  ],
  "blocks": [
    { "type": "beneficio", "name": "Beneficio", "settings": [
      { "type": "image_picker", "id": "icon", "label": "Ícono" },
      { "type": "text", "id": "title", "label": "Título", "default": "Beneficio" },
      { "type": "textarea", "id": "text", "label": "Descripción" }
    ]}
  ],
  "presets": [{
    "name": "Beneficios",
    "blocks": [
      { "type": "beneficio" }, { "type": "beneficio" }, { "type": "beneficio" },
      { "type": "beneficio" }, { "type": "beneficio" }, { "type": "beneficio" }
    ]
  }]
}
{% endschema %}
