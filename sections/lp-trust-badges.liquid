<style>
  .tb-wrap {
    background: {{ section.settings.bg_color }};
    padding: {{ section.settings.py }}px 16px;
  }
  .tb-box {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    background: transparent;
    border: none;
    box-shadow: none;
    display: grid;
    grid-template-columns: 1fr 1px 1fr;
    align-items: stretch;
    height: 70px;
    overflow: hidden;
  }
  .tb-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 0 8px;
    height: 70px;
    overflow: hidden;
  }
  .tb-icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .tb-icon-wrap img {
    width: 28px;
    height: 28px;
    object-fit: contain;
    display: block;
  }
  .tb-text {
    display: flex;
    flex-direction: column;
    gap: 1px;
    overflow: hidden;
  }
  .tb-title {
    font-weight: 700;
    font-size: 11px;
    color: #1a1a18;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .tb-sub {
    font-size: 9.5px;
    color: #1a1a18;
    line-height: 1.2;
    opacity: 0.6;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .tb-divider {
    background: #e0e0da;
    margin: 12px 0;
  }
</style>

<div class="tb-wrap">
  <div class="tb-box">

    <div class="tb-item">
      {% if section.settings.badge1_icon != blank %}
        <div class="tb-icon-wrap">
          <img src="{{ section.settings.badge1_icon | image_url: width: 80 }}" alt="">
        </div>
      {% endif %}
      <div class="tb-text">
        <div class="tb-title">{{ section.settings.badge1_title }}</div>
        <div class="tb-sub">{{ section.settings.badge1_sub }}</div>
      </div>
    </div>

    <div class="tb-divider"></div>

    <div class="tb-item">
      {% if section.settings.badge2_icon != blank %}
        <div class="tb-icon-wrap">
          <img src="{{ section.settings.badge2_icon | image_url: width: 80 }}" alt="">
        </div>
      {% endif %}
      <div class="tb-text">
        <div class="tb-title">{{ section.settings.badge2_title }}</div>
        <div class="tb-sub">{{ section.settings.badge2_sub }}</div>
      </div>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Trust Badges",
  "settings": [
    {
      "type": "image_picker",
      "id": "badge1_icon",
      "label": "Badge 1 — Ícono"
    },
    {
      "type": "text",
      "id": "badge1_title",
      "label": "Badge 1 — Título",
      "default": "Envío Gratis"
    },
    {
      "type": "text",
      "id": "badge1_sub",
      "label": "Badge 1 — Subtítulo",
      "default": "Entrega en 24-48h (Todo RD)"
    },
    {
      "type": "image_picker",
      "id": "badge2_icon",
      "label": "Badge 2 — Ícono"
    },
    {
      "type": "text",
      "id": "badge2_title",
      "label": "Badge 2 — Título",
      "default": "Paga en Casa"
    },
    {
      "type": "text",
      "id": "badge2_sub",
      "label": "Badge 2 — Subtítulo",
      "default": "Efectivo o Transferencia"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Fondo de sección",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Ancho máximo (px)",
      "min": 300,
      "max": 900,
      "step": 20,
      "default": 700
    },
    {
      "type": "range",
      "id": "py",
      "label": "Espacio vertical (px)",
      "min": 0,
      "max": 48,
      "step": 4,
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Trust Badges"
    }
  ]
}
{% endschema %}
