<section class="editorial editorial--{{ section.settings.align }}">
  <div class="editorial__media">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 1600 }}"
           srcset="{{ section.settings.image | image_url: width: 750 }} 750w, {{ section.settings.image | image_url: width: 1200 }} 1200w, {{ section.settings.image | image_url: width: 1600 }} 1600w"
           sizes="100vw"
           alt="{{ section.settings.heading | escape }}"
           width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}"
           loading="lazy">
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'editorial__placeholder' }}
    {%- endif -%}
    {%- if section.settings.overlay > 0 -%}
      <div class="editorial__overlay" style="opacity: {{ section.settings.overlay | divided_by: 100.0 }}"></div>
    {%- endif -%}
  </div>

  <div class="editorial__content page-width">
    <div class="editorial__box" style="--editorial-text: {{ section.settings.text_color }}">
      {%- if section.settings.eyebrow != blank -%}
        <p class="editorial__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="editorial__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="editorial__text rte">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Banner editorial",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen" },
    { "type": "range", "id": "overlay", "min": 0, "max": 80, "step": 5, "unit": "%", "label": "Oscurecer imagen", "default": 20 },
    { "type": "text", "id": "eyebrow", "label": "Etiqueta pequeña" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "Comprobado clínicamente para apoyar un mejor envejecimiento celular." },
    { "type": "richtext", "id": "text", "label": "Texto (opcional)" },
    { "type": "color", "id": "text_color", "label": "Color del texto", "default": "#FFFFFF" },
    {
      "type": "select", "id": "align", "label": "Alineación del texto", "default": "center",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" }
      ]
    }
  ],
  "presets": [{ "name": "Banner editorial" }]
}
{% endschema %}
