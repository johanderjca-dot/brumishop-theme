{% if section.blocks.size > 0 %}
<div style="background:{{ section.settings.bg_color }}; border-top:1px solid {{ section.settings.border_color }}; border-bottom:1px solid {{ section.settings.border_color }}; padding:{{ section.settings.py }}px 1.5rem;">
  <div style="max-width:{{ section.settings.max_width }}px; margin:0 auto; display:flex; flex-wrap:wrap; justify-content:center; align-items:center; gap:{{ section.settings.gap }}px;">
    {% for block in section.blocks %}
      <div {{ block.shopify_attributes }} style="display:flex; flex-direction:column; align-items:center; gap:6px; text-align:center;">
        {% if block.settings.image != blank %}
          <img src="{{ block.settings.image | image_url: width: 120 }}"
               alt="{{ block.settings.label | escape }}"
               style="width:{{ section.settings.img_size }}px; height:{{ section.settings.img_size }}px; object-fit:contain; display:block;">
        {% endif %}
        {% if block.settings.label != blank %}
          <span style="font-size:{{ section.settings.font_size }}px; font-weight:600; color:{{ section.settings.text_color }}; white-space:nowrap;">
            {{ block.settings.label }}
          </span>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>
{% endif %}

{% schema %}
{
  "name": "Badges de confianza",
  "settings": [
    { "type": "range", "id": "py", "label": "Espacio vertical (px)", "min": 8, "max": 48, "step": 4, "default": 16 },
    { "type": "range", "id": "gap", "label": "Separación entre badges (px)", "min": 12, "max": 80, "step": 4, "default": 32 },
    { "type": "range", "id": "img_size", "label": "Tamaño de imagen (px)", "min": 32, "max": 120, "step": 4, "default": 56 },
    { "type": "range", "id": "font_size", "label": "Tamaño del texto (px)", "min": 9, "max": 16, "step": 1, "default": 11 },
    { "type": "range", "id": "max_width", "label": "Ancho máximo (px)", "min": 400, "max": 1320, "step": 20, "default": 860 },
    { "type": "color", "id": "bg_color", "label": "Fondo", "default": "#ffffff" },
    { "type": "color", "id": "border_color", "label": "Color bordes", "default": "#e8e8e2" },
    { "type": "color", "id": "text_color", "label": "Color texto", "default": "#5a5a52" }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen del badge" },
        { "type": "text", "id": "label", "label": "Texto del badge", "default": "Envío a todo RD" }
      ]
    }
  ],
  "presets": [{
    "name": "Badges de confianza",
    "blocks": [
      { "type": "badge", "settings": { "label": "Envío a todo RD" } },
      { "type": "badge", "settings": { "label": "Paga al recibir" } },
      { "type": "badge", "settings": { "label": "Garantía del producto" } }
    ]
  }]
}
{% endschema %}
