{% assign cv = product.selected_or_first_available_variant %}

{% assign has_fake = false %}
{% if section.settings.fake_price_amount > 0 %}
  {% assign fake_cents = section.settings.fake_price_amount | times: 100 %}
  {% if fake_cents > cv.price %}
    {% assign has_fake = true %}
    {% assign savings_cents = fake_cents | minus: cv.price %}
    {% assign savings_pct = savings_cents | times: 100 | divided_by: fake_cents %}
  {% endif %}
{% endif %}

<section style="background:{{ section.settings.bg_color }}; padding:{{ section.settings.pt }}px 0 {{ section.settings.pb }}px;">
  <div style="max-width:{{ section.settings.max_width }}px; margin:0 auto; padding:0 1.5rem; text-align:center;">

    {% if section.settings.badge_text != blank %}
      <div style="display:inline-block; background:{{ section.settings.badge_bg }}; color:{{ section.settings.badge_color }}; font-size:0.7rem; font-weight:700; letter-spacing:0.18em; text-transform:uppercase; padding:0.4rem 1rem; border-radius:{{ section.settings.badge_radius }}px; margin-bottom:0.85rem;">
        {{ section.settings.badge_text }}
      </div>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 style="font-family:'Cormorant Garamond',Georgia,serif; font-size:clamp(1.5rem,3.5vw,2.5rem); font-weight:600; color:{{ section.settings.heading_color }}; margin-bottom:0.85rem; line-height:1.2;">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    <!-- Tarjeta de precio -->
    <div style="background:{{ section.settings.card_bg }}; border:{{ section.settings.card_border_width }}px solid {{ section.settings.card_border_color }}; border-radius:{{ section.settings.card_radius }}px; padding:{{ section.settings.card_pad }}px; max-width:{{ section.settings.card_max_width }}px; margin:0 auto;">

      <div style="display:flex; align-items:center; justify-content:center; gap:0.85rem; flex-wrap:wrap; margin-bottom:{% if has_fake or cv.compare_at_price > cv.price %}0.85rem{% else %}0{% endif %};">
        <span style="font-size:{{ section.settings.price_size }}px; font-weight:700; color:{{ section.settings.price_color }}; line-height:1;">
          {{ cv.price | money }}
        </span>
        {% if has_fake %}
          <span style="font-size:{{ section.settings.price_size | times: 0.55 | round }}px; color:#a0a09a; text-decoration:line-through; line-height:1;">
            {{ fake_cents | money }}
          </span>
        {% elsif cv.compare_at_price > cv.price %}
          <span style="font-size:{{ section.settings.price_size | times: 0.55 | round }}px; color:#a0a09a; text-decoration:line-through; line-height:1;">
            {{ cv.compare_at_price | money }}
          </span>
        {% endif %}
      </div>

      {% if has_fake %}
        <div style="background:{{ section.settings.savings_bg }}; border-radius:8px; padding:0.6rem 1.25rem; display:inline-flex; align-items:center; gap:0.5rem;">
          <span style="color:{{ section.settings.savings_color }}; font-size:0.85rem; font-weight:700;">
            ✓ Ahorras {{ savings_cents | money }} — {{ savings_pct }}% OFF
          </span>
        </div>
      {% endif %}

    </div>

    {% if section.settings.urgency_qty > 0 %}
      <p style="font-size:0.85rem; color:{{ section.settings.urgency_color }}; margin-top:1rem; margin-bottom:0; font-weight:600;">
        {{ section.settings.urgency_prefix | strip }} {{ section.settings.urgency_qty }} {{ section.settings.urgency_suffix | strip }}
      </p>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "4 — Precio y Oferta",
  "settings": [
    { "type": "header", "content": "── PRECIO ──────────────────────" },
    { "type": "range", "id": "price_size", "label": "Tamaño del precio (px)", "min": 24, "max": 64, "step": 2, "default": 42 },
    { "type": "color", "id": "price_color", "label": "Color del precio", "default": "#1a1a18" },
    { "type": "number", "id": "fake_price_amount", "label": "Precio tachado — solo el número (ej: 2500)", "default": 0 },

    { "type": "header", "content": "── TARJETA DE PRECIO ───────────" },
    { "type": "color", "id": "card_bg", "label": "Fondo de la tarjeta", "default": "#FFFFFF" },
    { "type": "color", "id": "card_border_color", "label": "Color del borde", "default": "#E0E0DA" },
    { "type": "range", "id": "card_border_width", "label": "Grosor del borde (px)", "min": 0, "max": 4, "step": 1, "default": 1 },
    { "type": "range", "id": "card_radius", "label": "Bordes redondeados (px)", "min": 0, "max": 24, "step": 2, "default": 12 },
    { "type": "range", "id": "card_pad", "label": "Relleno de la tarjeta (px)", "min": 12, "max": 48, "step": 4, "default": 24 },
    { "type": "range", "id": "card_max_width", "label": "Ancho máximo tarjeta (px)", "min": 280, "max": 640, "step": 20, "default": 420 },

    { "type": "header", "content": "── CAJA DE AHORRO ──────────────" },
    { "type": "color", "id": "savings_bg", "label": "Fondo de la caja de ahorro", "default": "#F0FFF4" },
    { "type": "color", "id": "savings_color", "label": "Color del texto de ahorro", "default": "#2d7a3a" },

    { "type": "header", "content": "── URGENCIA (0 = no aparece) ───" },
    { "type": "range", "id": "urgency_qty", "label": "Cantidad de unidades", "min": 0, "max": 99, "step": 1, "default": 0 },
    { "type": "text", "id": "urgency_prefix", "label": "Texto antes del número", "default": "⚡ Últimas" },
    { "type": "text", "id": "urgency_suffix", "label": "Texto después del número", "default": "unidades disponibles" },
    { "type": "color", "id": "urgency_color", "label": "Color del texto", "default": "#c0392b" },

    { "type": "header", "content": "── BADGE (vacío = no aparece) ──" },
    { "type": "text", "id": "badge_text", "label": "Texto del badge" },
    { "type": "color", "id": "badge_bg", "label": "Fondo del badge", "default": "#FFF3CD" },
    { "type": "color", "id": "badge_color", "label": "Color texto badge", "default": "#856404" },
    { "type": "range", "id": "badge_radius", "label": "Bordes redondeados badge (px)", "min": 0, "max": 50, "step": 2, "default": 50 },

    { "type": "header", "content": "── TÍTULO (vacío = no aparece) ─" },
    { "type": "text", "id": "heading", "label": "Título" },
    { "type": "color", "id": "heading_color", "label": "Color título", "default": "#1a1a18" },

    { "type": "header", "content": "── SECCIÓN ─────────────────────" },
    { "type": "range", "id": "max_width", "label": "Ancho máximo (px)", "min": 400, "max": 900, "step": 20, "default": 640 },
    { "type": "range", "id": "pt", "label": "Espacio superior (px)", "min": 0, "max": 80, "step": 1, "default": 15 },
    { "type": "range", "id": "pb", "label": "Espacio inferior (px)", "min": 0, "max": 80, "step": 1, "default": 15 },
    { "type": "color", "id": "bg_color", "label": "Fondo de la sección", "default": "#FFFFFF" }
  ],
  "presets": [{ "name": "4 — Precio y Oferta" }]
}
{% endschema %}
