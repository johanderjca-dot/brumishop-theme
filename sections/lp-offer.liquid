{% assign cv = product.selected_or_first_available_variant %}

{% assign has_fake = false %}
{% if section.settings.fake_price_amount > 0 %}
  {% assign fake_cents = section.settings.fake_price_amount | times: 100 %}
  {% if fake_cents > cv.price %}
    {% assign has_fake = true %}
    {% assign savings_cents = fake_cents | minus: cv.price %}
  {% endif %}
{% endif %}

<section style="background:{{ section.settings.bg_color }}; padding:{{ section.settings.pt }}px {{ section.settings.px }}px {{ section.settings.pb }}px;">

  <!-- Fila precio -->
  <div style="display:flex; align-items:baseline; gap:0.6rem; flex-wrap:wrap; justify-content:center; margin-bottom:{% if has_fake %}0.35rem{% else %}0{% endif %};">
    <span style="font-size:{{ section.settings.price_size }}px; font-weight:700; color:{{ section.settings.price_color }}; line-height:1;">
      {{ cv.price | money }}
    </span>
    {% if has_fake %}
      <span style="font-size:{{ section.settings.price_size | times: 0.6 | round }}px; color:#a0a09a; text-decoration:line-through; line-height:1;">
        {{ fake_cents | money }}
      </span>
    {% elsif cv.compare_at_price > cv.price %}
      <span style="font-size:{{ section.settings.price_size | times: 0.6 | round }}px; color:#a0a09a; text-decoration:line-through; line-height:1;">
        {{ cv.compare_at_price | money }}
      </span>
    {% endif %}
  </div>

  <!-- Badge ahorro -->
  {% if has_fake %}
    <div style="display:flex; justify-content:center; margin-bottom:{% if section.settings.urgency_qty > 0 %}0.35rem{% else %}0{% endif %};">
      <div style="display:inline-flex; align-items:center; background:{{ section.settings.savings_bg }}; border-radius:4px; padding:0.2rem 0.6rem;">
        <span style="color:{{ section.settings.savings_color }}; font-size:0.75rem; font-weight:700;">
          Ahorra {{ savings_cents | money }}
        </span>
      </div>
    </div>
  {% endif %}

  <!-- Urgencia -->
  {% if section.settings.urgency_qty > 0 %}
    <p style="font-size:0.78rem; color:{{ section.settings.urgency_color }}; margin:0; font-weight:600; text-align:center;">
      {{ section.settings.urgency_prefix | strip }} {{ section.settings.urgency_qty }} {{ section.settings.urgency_suffix | strip }}
    </p>
  {% endif %}

</section>

{% schema %}
{
  "name": "4 — Precio y Oferta",
  "settings": [
    { "type": "range", "id": "price_size", "label": "Tamaño del precio (px)", "min": 14, "max": 48, "step": 1, "default": 22 },
    { "type": "color", "id": "price_color", "label": "Color del precio", "default": "#1a1a18" },
    { "type": "number", "id": "fake_price_amount", "label": "Precio tachado — solo el número (ej: 2500)", "default": 0 },

    { "type": "header", "content": "Ahorro" },
    { "type": "color", "id": "savings_bg", "label": "Fondo badge ahorro", "default": "#F0FFF4" },
    { "type": "color", "id": "savings_color", "label": "Color texto ahorro", "default": "#2d7a3a" },

    { "type": "header", "content": "Urgencia (0 = no aparece)" },
    { "type": "range", "id": "urgency_qty", "label": "Cantidad de unidades", "min": 0, "max": 99, "step": 1, "default": 0 },
    { "type": "text", "id": "urgency_prefix", "label": "Texto antes del número", "default": "⚡ Últimas" },
    { "type": "text", "id": "urgency_suffix", "label": "Texto después del número", "default": "unidades disponibles" },
    { "type": "color", "id": "urgency_color", "label": "Color urgencia", "default": "#c0392b" },

    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "pt", "label": "Espacio superior (px)", "min": 0, "max": 48, "step": 2, "default": 8 },
    { "type": "range", "id": "pb", "label": "Espacio inferior (px)", "min": 0, "max": 48, "step": 2, "default": 8 },
    { "type": "range", "id": "px", "label": "Margen lateral (px)", "min": 0, "max": 32, "step": 2, "default": 16 },
    { "type": "color", "id": "bg_color", "label": "Fondo sección", "default": "#ffffff" }
  ],
  "presets": [{ "name": "4 — Precio y Oferta" }]
}
{% endschema %}
