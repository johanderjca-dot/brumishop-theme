{% assign cv = product.selected_or_first_available_variant %}

<style>
  .lp-offer-variant-input:checked + .lp-offer-variant-label {
    border-color: #1a1a18;
    background: #1a1a18;
    color: #fff;
  }
</style>

<section style="background:{{ section.settings.bg_color }}; padding:{{ section.settings.pt }}px 0 {{ section.settings.pb }}px;">
  <div style="max-width:{{ section.settings.max_width }}px; margin:0 auto; padding:0 1.5rem; text-align:center;">

    {% if section.settings.badge_text != blank %}
      <div style="display:inline-block; background:{{ section.settings.badge_bg }}; color:{{ section.settings.badge_color }}; font-size:0.7rem; font-weight:700; letter-spacing:0.18em; text-transform:uppercase; padding:0.4rem 1rem; border-radius:{{ section.settings.badge_radius }}px; margin-bottom:1.25rem;">
        {{ section.settings.badge_text }}
      </div>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 style="font-family:'Cormorant Garamond',Georgia,serif; font-size:clamp(1.5rem,3.5vw,2.75rem); font-weight:600; color:{{ section.settings.heading_color }}; margin-bottom:1rem; line-height:1.2;">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    <!-- Precio real + precio tachado -->
    <div style="display:flex; align-items:center; justify-content:center; gap:0.85rem; margin-bottom:0.75rem; flex-wrap:wrap;">
      <span id="lp-offer-price" style="font-size:{{ section.settings.price_size }}px; font-weight:700; color:{{ section.settings.price_color }};">
        {{ cv.price | money }}
      </span>
      {% if section.settings.fake_price != blank %}
        <span style="font-size:{{ section.settings.price_size | times: 0.7 | round }}px; color:#a0a09a; text-decoration:line-through;">
          {{ section.settings.fake_price }}
        </span>
      {% elsif cv.compare_at_price > cv.price %}
        <span id="lp-offer-compare" style="font-size:{{ section.settings.price_size | times: 0.7 | round }}px; color:#a0a09a; text-decoration:line-through;">
          {{ cv.compare_at_price | money }}
        </span>
        {% assign pct = cv.compare_at_price | minus: cv.price | times: 100 | divided_by: cv.compare_at_price %}
        <span style="background:#d63a3a; color:#fff; font-size:0.72rem; font-weight:700; padding:0.25rem 0.55rem; border-radius:4px;">
          AHORRAS {{ pct }}%
        </span>
      {% endif %}
    </div>

    {% if section.settings.urgency_qty > 0 %}
      <p style="font-size:0.85rem; color:{{ section.settings.urgency_color }}; margin-bottom:1.25rem; font-weight:600;">
        {{ section.settings.urgency_prefix }}{{ section.settings.urgency_qty }}{{ section.settings.urgency_suffix }}
      </p>
    {% endif %}

    {% form 'product', product, id: 'lp-offer-form' %}
      {% unless product.has_only_default_variant %}
        {% for option in product.options_with_values %}
          <div style="margin-bottom:1rem;">
            <p style="font-size:0.7rem; font-weight:700; letter-spacing:0.15em; text-transform:uppercase; color:#1a1a18; margin-bottom:0.6rem;">{{ option.name }}</p>
            <div style="display:flex; flex-wrap:wrap; gap:0.5rem; justify-content:center;">
              {% for value in option.values %}
                <label>
                  <input type="radio" name="options[{{ option.name }}]" value="{{ value }}"
                         class="lp-offer-variant-input" style="display:none;"
                         {% if option.selected_value == value %}checked{% endif %}>
                  <span class="lp-offer-variant-label"
                        style="display:inline-block; padding:0.5rem 1.1rem; font-size:0.8rem; font-weight:500; border:1.5px solid #E0E0DA; cursor:pointer; border-radius:3px; transition:all .15s; user-select:none;
                        {% if option.selected_value == value %}border-color:#1a1a18;background:#1a1a18;color:#fff;{% endif %}">
                    {{ value }}
                  </span>
                </label>
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      {% endunless %}
      <input type="hidden" name="id" id="lp-offer-variant-id" class="brumi-variant-id" value="{{ cv.id }}" data-brumi-variant>
    {% endform %}

  </div>
</section>

<script>
(function() {
  var form = document.getElementById('lp-offer-form');
  if (!form) return;
  var variants = {{ product.variants | json }};
  var options  = {{ product.options | json }};
  var radios   = form.querySelectorAll('.lp-offer-variant-input');

  function getSelected() {
    var sel = {};
    radios.forEach(function(r) {
      if (r.checked) { sel[r.name.replace('options[','').replace(']','')] = r.value; }
    });
    return sel;
  }

  radios.forEach(function(r) {
    r.addEventListener('change', function() {
      radios.forEach(function(inp) {
        var lbl = inp.nextElementSibling;
        if (inp.checked) { lbl.style.borderColor='#1a1a18'; lbl.style.background='#1a1a18'; lbl.style.color='#fff'; }
        else { lbl.style.borderColor=''; lbl.style.background=''; lbl.style.color=''; }
      });
      var v = variants.find(function(v) { return v.options.every(function(o,i){ return getSelected()[options[i]]===o; }); });
      if (!v) return;
      document.querySelectorAll('.brumi-variant-id').forEach(function(i){ i.value = v.id; });
      window.brumiSelectedVariantId = v.id;
      var priceEl = document.getElementById('lp-offer-price');
      if (priceEl) priceEl.textContent = (v.price/100).toLocaleString('es-DO',{style:'currency',currency:'{{ shop.currency }}'});
    });
  });

  window.brumiSelectedVariantId = {{ cv.id }};
})();
</script>

{% schema %}
{
  "name": "4 — Precio y Oferta",
  "settings": [
    { "type": "header", "content": "Badge (vacío = no aparece)" },
    { "type": "text", "id": "badge_text", "label": "Texto del badge" },
    { "type": "color", "id": "badge_bg", "label": "Fondo del badge", "default": "#FFF3CD" },
    { "type": "color", "id": "badge_color", "label": "Color texto badge", "default": "#856404" },
    { "type": "range", "id": "badge_radius", "label": "Bordes redondeados badge (px)", "min": 0, "max": 50, "step": 2, "default": 50 },

    { "type": "header", "content": "Título (vacío = no aparece)" },
    { "type": "text", "id": "heading", "label": "Título" },
    { "type": "color", "id": "heading_color", "label": "Color título", "default": "#1a1a18" },

    { "type": "header", "content": "Precio" },
    { "type": "range", "id": "price_size", "label": "Tamaño del precio real (px)", "min": 20, "max": 60, "step": 2, "default": 40 },
    { "type": "color", "id": "price_color", "label": "Color del precio", "default": "#1a1a18" },
    { "type": "text", "id": "fake_price", "label": "Precio tachado / precio anterior (ej: RD$2,500.00 — vacío = usa el de Shopify)" },

    { "type": "header", "content": "Urgencia (0 = no aparece)" },
    { "type": "range", "id": "urgency_qty", "label": "Cantidad de unidades", "min": 0, "max": 99, "step": 1, "default": 0 },
    { "type": "text", "id": "urgency_prefix", "label": "Texto antes del número", "default": "⚡ Últimas " },
    { "type": "text", "id": "urgency_suffix", "label": "Texto después del número", "default": " unidades disponibles" },
    { "type": "color", "id": "urgency_color", "label": "Color del texto de urgencia", "default": "#c0392b" },

    { "type": "header", "content": "Sección" },
    { "type": "range", "id": "max_width", "label": "Ancho máximo del contenido (px)", "min": 400, "max": 900, "step": 20, "default": 640 },
    { "type": "range", "id": "pt", "label": "Espacio superior (px)", "min": 0, "max": 80, "step": 1, "default": 15 },
    { "type": "range", "id": "pb", "label": "Espacio inferior (px)", "min": 0, "max": 80, "step": 1, "default": 15 },
    { "type": "color", "id": "bg_color", "label": "Fondo de la sección", "default": "#FAFAF6" }
  ],
  "presets": [{ "name": "4 — Precio y Oferta" }]
}
{% endschema %}
