<section class="max-w-[1320px] mx-auto px-6 py-10">
  <div class="grid grid-cols-3 gap-4">
    {% for block in section.blocks %}
      <div class="relative group overflow-hidden rounded-sm cursor-pointer" style="background: {{ block.settings.bg_color }}; min-height: 260px;">
        <div class="relative overflow-hidden" style="height: 180px;">
          {% if block.settings.image != blank %}
            <img src="{{ block.settings.image | image_url: width: 600 }}"
                 alt="{{ block.settings.title }}"
                 class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                 style="filter: contrast(1.05) saturate(0.85);">
          {% else %}
            <div class="w-full h-full bg-[#E8E8E2] flex items-center justify-center">
              <span class="text-xs text-[#a0a09a]">Sube una imagen</span>
            </div>
          {% endif %}
        </div>
        <div class="p-5">
          <h3 class="font-display text-lg font-semibold text-[#1a1a18] leading-tight">{{ block.settings.title }}</h3>
          {% if block.settings.subtitle != blank %}
            <p class="text-xs text-[#6a6a62] mt-1">{{ block.settings.subtitle }}</p>
          {% endif %}
          <a href="{{ block.settings.button_url }}" class="mt-3 text-xs font-semibold text-[#1a1a18] flex items-center gap-1 hover:gap-2 transition-all duration-200">
            {{ block.settings.button_label | default: 'Comprar Ahora' }} <span>&#8594;</span>
          </a>
        </div>
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Category Cards",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "color",
          "id": "bg_color",
          "label": "Background color",
          "default": "#FFFFFF"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Nuevas Llegadas"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Recién agregados"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button text",
          "default": "Comprar Ahora"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category Cards",
      "blocks": [
        { "type": "card", "settings": { "title": "Nuevas Llegadas", "subtitle": "Recién agregados", "button_label": "Comprar Ahora", "bg_color": "#FFFFFF" } },
        { "type": "card", "settings": { "title": "¿Qué Hay de Nuevo?", "subtitle": "Descúbrelo primero", "button_label": "Explorar", "bg_color": "#EEF0E7" } },
        { "type": "card", "settings": { "title": "Lleva 2 Paga 1", "subtitle": "Oferta limitada", "button_label": "Ver Ofertas", "bg_color": "#F2EDE6" } }
      ]
    }
  ]
}
{% endschema %}
