{% comment %}
  Usage: {% render 'product-card', product: product %}
{% endcomment %}

<div class="product-card group cursor-pointer">
  <div class="relative overflow-hidden bg-[#F8F7F3] rounded-sm" style="aspect-ratio: 1/1;">
    <a href="{{ product.url }}">
      {% if product.featured_image %}
        <img src="{{ product.featured_image | image_url: width: 500 }}"
             alt="{{ product.featured_image.alt | escape }}"
             class="product-img w-full h-full object-cover"
             loading="lazy">
      {% else %}
        <div class="w-full h-full flex items-center justify-center bg-[#E8E8E2]">
          <span class="text-xs text-[#a0a09a]">Sin imagen</span>
        </div>
      {% endif %}
    </a>

    {% if product.compare_at_price > product.price %}
      {% assign discount = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}
      <div class="absolute top-2.5 left-2.5 bg-[#5a7a40] text-white text-[10px] font-bold px-2 py-0.5 rounded-sm tracking-wide">
        -{{ discount }}%
      </div>
    {% endif %}

    {% unless product.available %}
      <div class="absolute top-2.5 right-2.5 bg-[#1a1a18] text-white text-[10px] font-bold px-2 py-0.5 rounded-sm">
        Agotado
      </div>
    {% endunless %}

    <div class="absolute bottom-3 left-3 right-3">
      {% form 'product', product %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <button type="submit"
                class="add-btn w-full bg-white text-[#1a1a18] text-xs font-semibold py-2.5 border border-[#E0E0DA] hover:bg-[#1a1a18] hover:text-white hover:border-[#1a1a18] transition-all duration-200"
                {% unless product.available %}disabled{% endunless %}>
          {% if product.available %}
            + Agregar al carrito
          {% else %}
            Agotado
          {% endif %}
        </button>
      {% endform %}
    </div>
  </div>

  <div class="mt-3 space-y-1">
    <a href="{{ product.url }}" class="block">
      <p class="text-xs text-[#6a6a62] hover:text-[#1a1a18] transition-colors">{{ product.title }}</p>
      <div class="flex items-center gap-2 mt-1">
        <span class="text-sm font-semibold text-[#1a1a18]">{{ product.price | money }}</span>
        {% if product.compare_at_price > product.price %}
          <span class="text-xs text-[#a0a09a] line-through">{{ product.compare_at_price | money }}</span>
        {% endif %}
      </div>
    </a>
  </div>
</div>
