{% if section.settings.eyebrow != blank %}
  <p style="font-size:0.7rem; font-weight:700; letter-spacing:0.2em; text-transform:uppercase; color:{{ section.settings.eyebrow_color }}; margin-bottom:0.75rem;">
    {{ section.settings.eyebrow }}
  </p>
{% endif %}
{% if section.settings.title != blank %}
  <h2 style="font-family:'Cormorant Garamond',Georgia,serif; font-size:clamp(1.75rem,3vw,2.75rem); font-weight:600; color:{{ section.settings.heading_color }}; margin-bottom:1rem; line-height:1.2;">
    {{ section.settings.title }}
  </h2>
{% endif %}
{% if section.settings.description != blank %}
  <div style="font-size:0.9rem; color:{{ section.settings.text_color }}; line-height:1.8;">
    {{ section.settings.description }}
  </div>
{% endif %}
